gui)
    entry="${XDG_DATA_HOME:-$HOME/.local/share}/applications/net.local.myrddin.desktop"
    case "${2:-}" in
    install)
        mkdir -p "$(dirname "$entry")"
        printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Myrddin' \
            'Comment=Launch games with frame generation' "Exec=\"$here/sc-turbo\" gui" \
            'Icon=applications-games' 'Terminal=false' 'Categories=Game;' 'StartupWMClass=net.local.myrddin' > "$entry"
        echo "Myrddin is in the application menu ($entry)" ;;
    remove) rm -f "$entry" && echo "removed from the application menu" ;;
    *) shift; exec "$here/gui/myrddin-gui" "$@" ;;
    esac ;;
fg-off)  touch "$here/logs/fg/OFF" && echo "generation off" ;;
fg-on)   rm -f "$here/logs/fg/OFF" && echo "generation on" ;;
fg-hud)  case "${2:-}" in
             off) touch "$here/logs/fg/HUDOFF" && echo "HUD handling off" ;;
             on) rm -f "$here/logs/fg/HUDOFF" && echo "HUD handling on" ;;
             *) echo "fg-hud on|off" ;; esac ;;
fg-layer) case "${2:-}" in
             off) touch "$here/logs/fg/HUDLAYEROFF" && echo "exact HUD layer off (picture-based detection instead)" ;;
             on) rm -f "$here/logs/fg/HUDLAYEROFF" && echo "exact HUD layer on" ;;
             mode) echo "${3:-0} ${4:-1} ${5:-0.006}" > "$here/logs/fg/LAYER" && echo "layer composite: mode ${3:-0} gain ${4:-1} floor ${5:-0.006}" ;;
             *) echo "fg-layer on|off|mode M [GAIN] [FLOOR]   (M: 0 blend, 1 hard, 2 show)" ;; esac ;;
fg-scd) case "${2:-}" in
             on) touch "$here/logs/fg/SCDON" && echo "FSR scene-change detector in use" ;;
             off) rm -f "$here/logs/fg/SCDON" && echo "FSR scene-change detector ignored (default)" ;;
             *) echo "fg-scd on|off" ;; esac ;;
fg-cap) case "${2:-}" in
             off) touch "$here/logs/fg/NOCAP" && echo "output not limited to the display's rate" ;;
             on) rm -f "$here/logs/fg/NOCAP" && echo "output limited to the display's rate (default)" ;;
             *) echo "fg-cap on|off" ;; esac ;;
fg-params) shift
    # (read by the layer in the running game; a launch with frame generation clears them)
    if ! pgrep -x StarCitizen.exe > /dev/null; then
        # (the RSI Launcher open after a launch with frame generation: the game it starts reads them.
        # The kernel keeps 15 letters of a process's name.)
        if pgrep -x 'RSI Launcher.ex' > /dev/null; then
            send_params "$@" && echo "parameters kept for the game the RSI Launcher starts: $*"
            exit 0
        fi
        echo "the game is not running: nothing to send these to. Parameters are for a game that is running,"
        echo "launched with \"sc-turbo fg\", and are cleared at the next launch."
        exit 1
