#!/usr/bin/env bash
# sc-turbo: launches Star Citizen with the layers of this project and controls them while it runs.
#
#   sc-turbo probe     launch the game through the normal sc-launch.sh with the passive
#                      probe layer loaded (nothing in the prefix or launch script changes)
#   sc-turbo capture   like probe, and also saves a few frames of DLSS's inputs (colour, motion
#                      vectors, depth) to logs/capture, but only after "sc-turbo go"
#   sc-turbo go        start a capture series now: 4 consecutive frames every 10 s for 2 minutes
#   sc-turbo fg [2|3|4] [fixed] [hud] [panel] [off] [nomarkers] [watch] [sched=NAME] [trace|old|older|next]  launch with frame generation (DLSS must be the
#                      upscaler in game); the number is the highest multiplier, default 2: up to it the
#                      layer picks the multiplier as the game's own rate changes (the launcher window's
#                      "Auto"). Log and dumps: logs/fg
#                      ("fixed": the multiplier is held at the number, whatever the game's rate (the
#                      window's x2, x3, x4); fg-mult changes either in the running game.
#                      5 to 8: experimental, only with SC_FG_EXPERIMENTAL=1 in sc-turbo.conf.
#                      "hud": with MangoHud, which sits below the layer and so counts every frame that
#                      is shown, the generated ones too; SC_MANGOHUD=1 in sc-turbo.conf: always.
#                      "panel": the layer's own performance panel can be shown, see fg-panel; without
#                      the word there is none.
#                      "off": the layer is loaded with generation off; fg-on (or the window) switches it
#                      on in the running game. With "panel", the panel without generated frames (the
#                      window's Off with Myrddin's panel).
#                      "nomarkers": HUD content that moves over the screen (world markers, the compass,
#                      a flight display) is left at the game's own rate. Without the word it
#                      is put where it is on its way in every generated frame (SC_FG_MARKERS=0 in
#                      sc-turbo.conf: never); fg-params markers=0|1 switches it in the running game.
#                      "watch": record what the game does with the disk and with memory (see iowatch).
#                      "sched=NAME[:MODE]": the kernel's CPU scheduler for as long as the game runs, a
#                      sched_ext one of scx-scheds (lavd, bpfland, ...; MODE one of scx_loader's, default
#                      gaming), the stock one again after it (and after ten minutes more while the RSI
#                      Launcher is open, for a game started again from it); SC_SCHED=NAME in sc-turbo.conf: always,
#                      sched=stock: not this time. Needs scx-scheds, scx-tools and switching without a
#                      password (tools/sc-sched rule); otherwise the game runs with the stock one.
#                      SC_PREFETCH=off and SC_THP=on in sc-turbo.conf: the CPU's hardware prefetchers off and
#                      huge pages on for as long as the game runs, back as they were after it (tools/sc-tune
#                      follow). Needs Myrddin's root helper, set up by hand (docs/advanced-performance-tweaking.md); without it
#                      nothing is switched and the launch says so.
#                      "old": the build before the last one, kept in build/fg-prev; "older": the one
#                      before that, build/fg-prev2; "next": the newest build, which ./build.sh
#                      leaves in build/fg-next before it is validated and installed: for a diagnosis)
#   sc-turbo gui [install|remove]   the launcher window: the game's icon (a click launches it) and - Nx +
#                      below it for the multiplier, also while the game runs (gui/games.ini lists the
#                      games). install / remove: its entry in the desktop's application menu.
#   sc-turbo run [hud] [watch] [sched=NAME]   launch the game as it is, with none of this project's layers (SC_SCHED applies;
#                      "watch" records as with fg; "hud" or SC_MANGOHUD=1: with MangoHud, which shows the game's own rate)
#   sc-turbo latency [PID]   where the time goes between a frame of the game and the display, per
#                      multiplier (default: the newest session; the display's part needs a runner whose
#                      vkd3d-proton asks the driver for it, which the LUG experimental ones do).
#   sc-turbo iowatch [report [PID]]   record the game's disk, memory and GPU memory use, second by second,
#                      from outside (it reads /proc and asks nvidia-smi; started by itself with "fg N watch");
#                      report: the recording put together with the frame rates and the game's log, place by place
#   sc-turbo fg-off / fg-on   switch generation off / on while the game runs
#   sc-turbo fg-mult N [fixed|auto]   change the multiplier (2, 3 or 4; to 8 when experimental) while the game runs. "fixed": it is
#                      held at N; "auto": it follows the game's rate, up to N; without a word it stays
#                      held or following as it was (following: N is the new limit)
#   sc-turbo fg-hud on|off   switch the HUD handling (keeps the HUD in place) while the game runs
#   sc-turbo fg-layer on|off|mode M [GAIN] [FLOOR]   exact HUD separation (the game's own HUD layer)
#   sc-turbo fg-scd on|off   FSR's scene-change detector (off by default: it stops interpolation in fast turns)
#   sc-turbo fg-cap on|off   limit shown frames to the display's rate (on by default; holds the game at rate/multiplier)
#   sc-turbo fg-panel [next|off|1|2|3] [tl|tr|bl|br] [key=KEYS]   the performance panel over the picture (only in
#                      a game launched with the word "panel": sc-turbo fg 4 panel; such a launch shows it
#                      from the start). In the game a key steps it on, Shift+7 unless another is named:
#                      off -> 1 the frame rate that is shown ("FG") -> 2 that and the game's own ("BASE"),
#                      with the multiplier -> 3 both and a graph of the time between shown frames (even
#                      pacing is a flat line) -> off. The layer reads the key inside the game, while the
#                      game has the keyboard: no desktop shortcut, the same on every desktop. The game gets
#                      the key as well, so pick one it does not use. Without a word (or "next") this command
#                      does the same step from outside. tl tr bl br: the corner it sits in. key=KEYS: another
#                      key for the running game, like key=Ctrl+F9 (Ctrl, Shift, Alt with a letter, a digit,
#                      F1 to F12 ...; keys by their place on a US keyboard); SC_FG_PANEL_KEY=KEYS in
#                      sc-turbo.conf keeps it for every launch.
#   sc-turbo stop      end the session: the game, the RSI Launcher and what else of Wine runs in the prefix
#                      are asked to end (SIGTERM: at once, nothing of the game is written out), then Wine's
#                      server, which saves the prefix's registry. Says what is still there after two seconds.
#   sc-turbo kill      the same without asking (SIGKILL), for a session that "stop" did not end
#   sc-turbo fg-params name=value ...   tune the HUD detection while the game runs
#                      (bias ratio motion up down level grow), or switch parts of the frame
#                      matching to compare in place: chain=0|1 (frames matched to their captures by
#                      the hand-over), nohud=0|1 (a frame without a HUD capture: 0 restart, 1 go on
#                      with the last capture), wait=0|1 (wait until generated frames are ready),
#                      shift=N (move the match by N captures), vectors=0|1 (the game's motion vectors
#                      checked against the picture: cures objects that flicker, like the hangar hoses),
#                      or parts of the frame limiter: gate=0|1 (the game's frames let on in step with
#                      the present call), guard=0|1 (the next frame kept back while the last waits to
#                      be copied out), first=0|1 (the generated frames' GPU work goes before the game's
#                      next frame), gpuwait=0|1 (off by default; the game's next frame waits until the
#                      GPU is done with the one before: no frames queued on a GPU that is the slower
#                      one, so the picture is a frame's time newer, but a hitch of the game then costs
#                      a frame). "gate=0 guard=0 first=0 gpuwait=0" is how it was before these four.
#                      How the multiplier follows the game: fill=0 the most generated frames that do not
#                      hold the game back (a game that could do 50 a second gets x2 and shows 100: what a
#                      window's "Performance" on, SC_FG_FILL=0 in sc-turbo.conf), fill=1 the fewest that fill the
#                      display (the same game gets x3, is held at 40 and shows 120, evenly: a smoother picture with
#                      more delay, what a launch sets); probe=0|1 (a held game is asked what it could do by letting
#                      one frame on early now and then, instead of guessing); adapt=0 the multiplier is
#                      held where it was asked for, adapt=1 (default) it follows the game's rate (what
#                      "fg N fixed" and "fg-mult N fixed|auto" set).
#                      A frame that comes without a HUD capture of its own: gapfill=1 (default) its scene is
#                      worked out from the frame and the last capture, and the HUD stays apart from what is
#                      interpolated; gapfill=0: such frames are not generated from, and when several come
#                      close together the HUD is interpolated with the picture for a few seconds.
#                      cross=1 (default): a frame copy recorded apart from the HUD pass still makes a capture.
#                      boost=1: the GPU is asked to keep its speed up while the game leaves it half idle, so
#                      that the generated frames are ready sooner (off by default; SC_FG_BOOST=1 at launch).
#                      priority=N: the thread that presents runs at nice -N, as far as the limits of the
#                      user allow (0, the default: left as it is; SC_FG_PRIORITY=N at launch).
#                      timing=1: every frame sent out asks the display when it got there (off by default;
#                      SC_FG_TIMING=1 at launch): for "sc-turbo latency", and which frames never reached it.
#                      pictures=1 (default): pictures in the HUD that change where they stand (the map) stay
#                      at the game's own rate; pictures=0: they are moved like the rest (their lines double)
#   sc-turbo fg-watch [--last N]   the session's log at a glance: a short line per ten seconds (frame
#                      rates, frame times, what the limiter did) and every change of the multiplier
#   sc-turbo fg-ab "A" "B" [SECONDS] [CYCLES]   two settings compared within the running session: switched
#                      back and forth (20 s each, 4 times), frame rates of each side. A, B: what fg-params
#                      takes, e.g. sc-turbo fg-ab "gate=1 guard=1 first=1" "gate=0 guard=0 first=0"
#                      (hold a steady view meanwhile)
#   sc-turbo threads   where the game's threads may run (by name)
#   sc-turbo threads-ab A B [SECONDS] [CYCLES]   two thread placements compared within the running session
#                      (asis | all | own-core | bg-low | all-bg-low | main-p; generation is off meanwhile, so the
#                      game runs at its own speed)
#   sc-turbo displays  the displays and which one the game takes as its main one (the desktop's primary
#                      display; another one: SC_MONITOR=NAME ./sc-turbo fg 4). Its refresh rate is what
#                      the layer fills (another rate: SC_FG_TARGET=RATE)
#   sc-turbo fg-events   write the last ~4000 presents (which captures, timings) to logs/fg/events-*.txt;
#                      with fg-params timing=1 also what became of each frame sent, logs/fg/presents-*.bin
#                      (tools/display-timing.py FILE: when the display takes frames, which ones it drops)
#   sc-turbo fg-scan  (trace launches) save the display-size passes before/after, to find the HUD pass
#   sc-turbo fg-where [-a] [PID]   what every thread was doing inside the layer (which hook, since when,
#                      which of its locks held and waited for): after a game that stood still, or while it runs
#   sc-turbo fg-dump [N]   save the next real + generated frame pair (and vectors/depth, the HUD layer) to
#                      logs/fg; N (up to 8): that many frames in a row (writing one takes 60 to 85 ms and
#                      holds the game that long: only the first is a frame at the game's own pace, the
#                      others are that far apart, with three to four times the motion between them)
#   sc-turbo fg-stat   last frame-rate lines of the running/last fg session
#   sc-turbo check     run while the game is in a session: ntsync, thread placement, probe stats
#   sc-turbo report    summarize the newest probe log of StarCitizen.exe
set -u
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Where the game is on this machine: sc-turbo.conf beside this script (see sc-turbo.conf.example),
# or the same names in the environment, which win.
#   SC_PREFIX  the Wine prefix Star Citizen is installed in (default: ~/Games/star-citizen)
#   SC_LAUNCH  the script that starts the game through Wine (default: sc-launch.sh in the prefix)
#   The launch script itself is never changed. The game is started from a copy of it, written anew at
#   every launch to logs/launch/, with this project's settings placed before the line that starts the
#   game (tools/sc-launch-copy). What is placed:
#   What is placed for NVIDIA is what the LUG's wiki gives (Troubleshooting > Nvidia), each setting
#   only where the script or the environment has not set it:
#   SC_NVIDIA_FLAGS=0  leaves all of it out: the three groups below and the driver's shader cache
#                      settings of the LUG's script (on, 10 GiB, not cleaned at start)
#   SC_DLSS_OVERRIDE=0 leaves out "DLSS 4": NVIDIA's updater for DLSS (it fetches the current DLSS
#                      from NVIDIA into the prefix) and dxvk-nvapi's override that makes the game use
#                      it, with its newest preset, in place of the DLSS the game came with
#   SC_DLSS_INDICATOR=1  DLSS's own indicator in the game for this launch (its version and preset);
#                      the launch after it switches the indicator off again. dxvk-nvapi keeps this
#                      one in the prefix's registry, which is why it is never placed unasked.
#                      A check, read while standing still: generated frames smear the text in motion.
#   SC_VRAM_LIMIT      auto (the default), off, or a number of MiB: how much memory the game is told
#                      the graphics card has, through Mesa's layer VK_LAYER_MESA_vram_report_limit.
#                      auto takes the wiki's table (12 GB: 9216, 10: 8192, 8: 6144, 6: 4096, 4: 2048)
#                      and leaves larger cards alone. The layer is looked for on the system and in
#                      build/vram-limit; without it, or where nvidia-smi cannot name the card, nothing is
#                      placed and the launch says so. Of several different NVIDIA cards the limit is for
#                      the first one nvidia-smi names, which the launch says as well.
#   SC_LAUNCH_SET      "NAME=value NAME=value": environment settings that win over the script's own
#   SC_RUNNER          the folder of another Wine runner (the one that holds bin/wine), for this launch
#   SC_LAUNCH_COPY=0   starts the launch script itself, with nothing placed
env_prefix="${SC_PREFIX:-}"; env_launch="${SC_LAUNCH:-}"; env_hud="${SC_MANGOHUD:-}"
env_nvidia="${SC_NVIDIA_FLAGS:-}"; env_set="${SC_LAUNCH_SET:-}"; env_runner="${SC_RUNNER:-}"; env_copy="${SC_LAUNCH_COPY:-}"
env_dlss="${SC_DLSS_OVERRIDE:-}"; env_ind="${SC_DLSS_INDICATOR:-}"; env_vram="${SC_VRAM_LIMIT:-}"
[ -f "$here/sc-turbo.conf" ] && . "$here/sc-turbo.conf"
SC_NVIDIA_FLAGS="${env_nvidia:-${SC_NVIDIA_FLAGS:-1}}"; SC_LAUNCH_SET="${env_set:-${SC_LAUNCH_SET:-}}"
SC_RUNNER="${env_runner:-${SC_RUNNER:-}}"; SC_LAUNCH_COPY="${env_copy:-${SC_LAUNCH_COPY:-1}}"
SC_DLSS_OVERRIDE="${env_dlss:-${SC_DLSS_OVERRIDE:-1}}"; SC_DLSS_INDICATOR="${env_ind:-${SC_DLSS_INDICATOR:-}}"
SC_VRAM_LIMIT="${env_vram:-${SC_VRAM_LIMIT:-auto}}"
SC_MANGOHUD="${env_hud:-${SC_MANGOHUD:-0}}"
SC_PREFIX="${env_prefix:-${SC_PREFIX:-$HOME/Games/star-citizen}}"
launch="${env_launch:-${SC_LAUNCH:-$SC_PREFIX/sc-launch.sh}}"
# The launch itself. What it starts leaves no core dump: when the game ends abnormally, the system's
# crash handler would otherwise write out all of its memory first, with the game's process (and its
# window) staying until that is done: 25 GB took 110 seconds on 2026-11-20. Nothing reads such a dump.
launch_now() {
    ulimit -c 0 2>/dev/null
    exec "$launch"
}
# The Wine processes of the prefix, "KIND PID" a line (KIND: game, server or other), for "stop" and
# "kill": this user's processes whose program is one of Wine's (wine, wine64-preloader, wineserver ...)
# and whose environment names this prefix. Only what a process was started with is looked at.
prefix_processes() {
    local want dir pid exe value name
    want="$(realpath -m "$SC_PREFIX" 2>/dev/null)" || return 0
    for dir in /proc/[0-9]*; do
        [ -O "$dir" ] || continue
        exe="$(readlink "$dir/exe" 2>/dev/null)" || continue
        exe="${exe% (deleted)}"
        case "${exe##*/}" in wine*) ;; *) continue ;; esac
        value="$(tr '\0' '\n' < "$dir/environ" 2>/dev/null | sed -n 's/^WINEPREFIX=//p' | head -1)"
        [ -n "$value" ] && [ "$(realpath -m "$value" 2>/dev/null)" = "$want" ] || continue
        pid="${dir#/proc/}"; name="$(cat "$dir/comm" 2>/dev/null)"
        case "${exe##*/}" in wineserver*) echo "server $pid"; continue ;; esac
        case "$name" in StarCitizen.exe) echo "game $pid" ;; *) echo "other $pid" ;; esac
    done
}
# The keys the layer knows for the panel (fg/panel_key.h): Ctrl, Shift, Alt and one key.
panel_key_known() {
    local key="${1,,}" part
    while [[ "$key" == *+?* ]]; do
        part="${key%%+*}"; key="${key#*+}"
        case "$part" in ctrl|control|shift|alt) ;; *) return 1 ;; esac
    done
    case "$key" in
    [0-9a-z]|f[1-9]|f1[0-2]|-|=|\[|\]|\;|\'|\`|\\|,|.|/) return 0 ;;
    tab|minus|equal|grave|backslash|scrolllock|home|pageup|end|pagedown|insert|delete|pause) return 0 ;;
    esac
    return 1
}
# MangoHud where sc-turbo.conf says SC_MANGOHUD=1 or the launch says "hud" (the window's overlay
# choice "MangoHud"); "layer": below this project's layer, so it counts the generated frames too.
mangohud_on() {
    [ "${SC_MANGOHUD:-0}" = 1 ] || return 0
    # (ls fails when any one of the places has none, so what it lists is what counts)
    if [ -n "$(ls /usr/share/vulkan/implicit_layer.d/MangoHud*.json /etc/vulkan/implicit_layer.d/MangoHud*.json \
            "$HOME"/.local/share/vulkan/implicit_layer.d/MangoHud*.json 2>/dev/null)" ]; then
        export MANGOHUD=1
        if [ "${1:-}" = layer ]; then
            echo "MangoHud on: the frame rate it shows is the shown one, generated frames included"
            echo "  (its own frame limit must stay off: fps_limit in MangoHud's settings would hold the layer's presents)"
        else
            echo "MangoHud on: the frame rate it shows is the game's own"
        fi
    else
        echo "MangoHud is not installed: launched without it"
    fi
}
# Whether N is a multiplier sc-turbo takes: 2 to 4, and 5 to 8 with SC_FG_EXPERIMENTAL=1. Says why not.
multiplier_allowed() {
    case "$1" in
    [2-4]) return 0 ;;
    [5-8]) [ "${SC_FG_EXPERIMENTAL:-0}" = 1 ] && return 0
           echo "${2:+$2: }x$1 is experimental: SC_FG_EXPERIMENTAL=1 in sc-turbo.conf allows 5 to 8 (the window: Options,"
           echo "  \"Experimental: 5x to 8x\"). It acts from the next launch: room for the frames is made when the game starts." ;;
    *) echo "${2:+$2: }the multiplier is 2, 3 or 4 (5 to 8 with the experimental setting)" ;;
    esac
    return 1
}
need_launch() {
    if [ ! -x "$launch" ]; then
        echo "no launch script at $launch"
        echo "set SC_PREFIX or SC_LAUNCH in $here/sc-turbo.conf (see sc-turbo.conf.example)"
        exit 1
    fi
    own_launch
}
# The LUG wiki's remedy for graphics memory running out on NVIDIA cards ("Severe frame drops"): the
# game is told the card has less memory than it has, and so leaves room for everything else on the
# card (the desktop, DLSS, this project's layer). Adds to args[] of own_launch. Says what it did.
vram_limit() {
    local total dev name gb mib dir cards line other="" found="" data="${XDG_DATA_HOME:-$HOME/.local/share}"
    case "$SC_VRAM_LIMIT" in off|0) return 0 ;; esac
    # The card and its memory are asked of the driver's own tool. Where that cannot be done, no limit is
    # set, and that is said: a launch that silently has none looks the same as one that has.
    if ! command -v nvidia-smi > /dev/null 2>&1; then
        echo "NOTE: the graphics memory limit is not set: nvidia-smi, which names the card and its memory, was"
        echo "  not found (it comes with NVIDIA's driver; SC_VRAM_LIMIT=off ends this note)."
        return 0
    fi
    cards="$(nvidia-smi --query-gpu=memory.total,pci.device_id,name --format=csv,noheader,nounits 2>/dev/null)"
    IFS=', ' read -r total dev name <<< "${cards%%$'\n'*}"
    case "$total$dev" in ''|*[!0-9A-Fa-fx]*) dev="" ;; esac
    if [ "${#dev}" != 10 ]; then                              # 0xDDDDVVVV: device, then vendor
        echo "NOTE: the graphics memory limit is not set: nvidia-smi named no card and its memory"
        echo "  (SC_VRAM_LIMIT=off ends this note)."
        return 0
    fi
    case "$SC_VRAM_LIMIT" in
    auto)
        gb=$(( (total + 512) / 1024 ))
        case "$gb" in 12) mib=9216 ;; 10|11) mib=8192 ;; 8|9) mib=6144 ;; 6|7) mib=4096 ;; 4|5) mib=2048 ;; *) return 0 ;; esac ;;
    *[!0-9]*) echo "SC_VRAM_LIMIT is auto, off or a number of MiB, not \"$SC_VRAM_LIMIT\""; exit 1 ;;
    *) mib="$SC_VRAM_LIMIT" ;;
    esac
    for dir in /usr/share/vulkan/explicit_layer.d /usr/share/vulkan/implicit_layer.d /usr/local/share/vulkan/explicit_layer.d \
               /etc/vulkan/explicit_layer.d "$data/vulkan/explicit_layer.d" "$data/vulkan/implicit_layer.d" "$here/build/vram-limit"; do
        grep -qs VK_LAYER_MESA_vram_report_limit "$dir"/*.json && { found="$dir"; break; }
    done
    if [ -z "$found" ]; then
        echo "NOTE: the graphics memory limit is not set: Mesa's layer VK_LAYER_MESA_vram_report_limit is not"
        echo "  installed (package vulkan-mesa-layers or similar, or tools/build-vram-layer.sh; SC_VRAM_LIMIT=off"
        echo "  ends this note)."
        return 0
    fi
    dev="$(printf '%s' "$dev" | tr 'A-F' 'a-f')"
    args+=(--append VK_LOADER_LAYERS_ENABLE=VK_LAYER_MESA_vram_report_limit
           --default "VK_VRAM_REPORT_LIMIT_HEAP_SIZE=$mib" --default "VK_VRAM_REPORT_LIMIT_DEVICE_ID=0x${dev:6:4}:0x${dev:2:4}")
    [ "$found" = "$here/build/vram-limit" ] && args+=(--append-path "VK_ADD_LAYER_PATH=$found")
    echo "Graphics memory: the game is told $mib MiB of $total (SC_VRAM_LIMIT=off leaves it alone)"
    # Several NVIDIA cards of different kinds: the limit names one card, the first the driver's tool lists.
    while IFS= read -r line; do
        IFS=', ' read -r _ other _ <<< "$line"
        [ -n "$other" ] && [ "$(printf '%s' "$other" | tr 'A-F' 'a-f')" != "$dev" ] && { other=differs; break; }
        other=""
    done <<< "$cards"
    if [ "$other" = differs ]; then
        echo "NOTE: there is more than one NVIDIA card here. The limit is for the first one nvidia-smi names${name:+, $name}."
        echo "  A game that runs on another card gets no limit."
    fi
}
# From here on "$launch" is this project's copy of the user's launch script (see the top of this part).
# A script no copy can be made of (not a shell script, or one that looks for its files from its own
# place) is started as it is; what sc-turbo exports reaches it all the same.
own_launch() {
    [ "$SC_LAUNCH_COPY" = 0 ] && return 0
    local copy word args=()
    copy="$here/logs/launch/$(basename "$launch")"
    if [ "$SC_NVIDIA_FLAGS" != 0 ]; then
        args+=(--default __GL_SHADER_DISK_CACHE=1 --default __GL_SHADER_DISK_CACHE_SIZE=10737418240
               --default __GL_SHADER_DISK_CACHE_SKIP_CLEANUP=1)
        if [ "$SC_DLSS_OVERRIDE" != 0 ]; then
            args+=(--default PROTON_ENABLE_NGX_UPDATER=1
                   --default DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE=on
                   --default DXVK_NVAPI_DRS_NGX_DLSS_RR_OVERRIDE=on
                   --default DXVK_NVAPI_DRS_NGX_DLSS_FG_OVERRIDE=on
                   --default DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION=render_preset_latest
                   --default DXVK_NVAPI_DRS_NGX_DLSS_RR_OVERRIDE_RENDER_PRESET_SELECTION=render_preset_latest)
        fi
        vram_limit
    fi
    # DLSS's indicator: on when asked for; the launch after that takes it off again (the wiki's steps 5 and 6)
    if [ "$SC_DLSS_INDICATOR" = 1 ]; then
        args+=(--default "DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS=DLSSIndicator=1024,DLSSGIndicator=2")
        mkdir -p "$here/logs/launch"; : > "$here/logs/launch/dlss-indicator-on"
        # DLSS draws the indicator into the scene itself, before the HUD. Generated frames move it
        # along with what is behind it, and that is left so: it is a check, read while standing still.
        echo "DLSS's indicator is on for this launch: its version and preset, in a corner of the game's picture"
        echo "  (a check, to be read while standing still: with frame generation the text smears when the picture moves)"
    elif [ "$SC_DLSS_INDICATOR" = 0 ] || [ -e "$here/logs/launch/dlss-indicator-on" ]; then
        args+=(--default "DXVK_NVAPI_SET_NGX_DEBUG_OPTIONS=DLSSIndicator=1,DLSSGIndicator=1")
        rm -f "$here/logs/launch/dlss-indicator-on"
    fi
    for word in $SC_LAUNCH_SET; do args+=(--set "$word"); done
    if [ -n "$SC_RUNNER" ]; then
        [ -x "$SC_RUNNER/bin/wine" ] || { echo "SC_RUNNER: no Wine at $SC_RUNNER/bin/wine"; exit 1; }
        args+=(--runner "$SC_RUNNER/bin")
    fi
    if "$here/tools/sc-launch-copy" "$launch" "$copy" ${args[@]+"${args[@]}"}; then
        launch="$copy"
    elif [ -n "$SC_RUNNER" ]; then
        echo "SC_RUNNER is set and no copy of the launch script could be made: not starting"
        exit 1
    else
        echo "the launch script is started as it is: $launch"
    fi
}
# Said before a launch with frame generation, when the launch script names a runner without
# vkd3d-proton (its d3d12core.dll is then Wine's own, some 50 KB against 5 MB and more). With
# vkd3d-proton the game presents through Direct3D 12, and that swapchain is the one generated
# frames go into; without it the game presents through a swapchain of its own, which it does not
# let a layer change. (Read off the script's wine_path line; said only when that can be told.)
runner_note() {
    local bin dll
    bin=$(sed -n 's/^[[:space:]]*\(export[[:space:]]\+\)\?wine_path="\(\/[^"$]*\)".*/\2/p' "$launch" 2>/dev/null | head -1)
    dll="${bin%/bin}/lib/wine/x86_64-windows/d3d12core.dll"
    [ -n "$bin" ] && [ -f "$dll" ] || return 0
    [ "$(stat -c %s "$dll")" -lt 1000000 ] || return 0
    echo "NOTE: the runner $(basename "${bin%/bin}") has no vkd3d-proton, and frame generation needs it:"
    echo "  the game will not get generated frames. The LUG's experimental runners have it."
}
# Said before a launch with frame generation, when the prefix lacks what DLSS needs under Wine: NVAPI
# (nvapi64.dll of dxvk-nvapi, which the LUG Helper installs) and the NVIDIA driver's NGX libraries
# (nvngx.dll and _nvngx.dll, which the LUG's runners link into the prefix from the driver's own "wine"
# folder). No launch setting stands in for them: without them the game offers no DLSS, and frame
# generation has nothing to read. Nothing is put into the prefix from here.
#
# And when the game itself is not set to DLSS: its own settings file says which upscaler is chosen
# ("UpscalingTechnique", 2 for DLSS: what the file held on 2026-11-20 while the game's log said
# "DLSS initialized successfully"). The file of the channel played last is read, and only read.
dlss_note() {
    local sys="$SC_PREFIX/drive_c/windows/system32" miss="" file newest=""
    [ -d "$sys" ] || return 0
    [ -e "$sys/nvapi64.dll" ] || miss="nvapi64.dll (dxvk-nvapi: the LUG Helper installs it)"
    [ -e "$sys/nvngx.dll" ] && [ -e "$sys/_nvngx.dll" ] ||
        miss="${miss:+$miss, }nvngx.dll and _nvngx.dll (the NVIDIA driver's NGX libraries: a LUG runner links them in)"
    if [ -n "$miss" ]; then
        echo "NOTE: the prefix has no $miss."
        echo "  DLSS needs them, and without DLSS selected in the game there are no generated frames."
    fi
    for file in "$SC_PREFIX/drive_c/Program Files/Roberts Space Industries/StarCitizen"/*/[uU][sS][eE][rR]/[cC]lient/0/Profiles/default/attributes.xml; do
        [ -f "$file" ] || continue
        if [ -z "$newest" ] || [ "$file" -nt "$newest" ]; then newest="$file"; fi
    done
    # (a file that names no upscaler at all says nothing either way: no note then)
    if [ -n "$newest" ] && grep -Eq '<Attr[[:space:]]+name="UpscalingTechnique"[[:space:]]' "$newest" &&
        ! grep -Eq '<Attr[[:space:]]+name="UpscalingTechnique"[[:space:]]+value="2"' "$newest"; then
        echo "NOTE: the game's upscaler is not set to DLSS: no frames are generated until it is"
        echo "  (in the game: Options > Graphics > Upscaling Technique)."
    fi
}
# Said before a launch: desktop settings known to get in the game's way.
# KDE's Plasma Keyboard (the on-screen keyboard service) offers accented letters when a physical
# key is held. It does that for every program that takes text input, which Wine's Wayland driver
# always does: the letters that have accents (A, S, D, C, E ...) then reach the game as text and
# not as held keys, and only the others (W, F, Q ...) act.
# KWin lets a fullscreen window tear (its default). Seen with this game on Plasma 6.8: the picture
# tore, generated frames included, until that was switched off.
desktop_notes() {
    command -v kreadconfig6 >/dev/null 2>&1 || return 0
    if pgrep -x plasma-keyboard >/dev/null 2>&1 &&
       [ "$(kreadconfig6 --file plasmakeyboardrc --group General --key diacriticsPopupEnabled --default true 2>/dev/null)" != false ]; then
        echo "NOTE: KDE's on-screen keyboard offers accented letters on a held key. While it does, held"
        echo "  A, S, D, C, E ... do not reach the game as keys (W does). To switch that off:"
        echo "  kwriteconfig6 --file plasmakeyboardrc --group General --key diacriticsPopupEnabled --type bool --notify false"
        echo "  (or System Settings > On-Screen Keyboard)"
    fi
    case "${XDG_CURRENT_DESKTOP:-}" in *KDE*)
        if [ "$(kreadconfig6 --file kwinrc --group Compositing --key AllowTearing --default true 2>/dev/null)" != false ]; then
            echo "NOTE: KWin allows tearing in fullscreen windows. If the picture tears, switch that off:"
            echo "  kwriteconfig6 --file kwinrc --group Compositing --key AllowTearing --type bool false"
            echo "  busctl --user call org.kde.KWin /KWin org.kde.KWin reconfigure"
            echo "  (or System Settings > Display & Monitor > Screen tearing)"
        fi ;;
    esac
}
# The display the game is on, asked of the desktop (tools/sc-monitor) at every launch: its name
# for the runner's Wayland driver, which left to itself takes the display with the most pixels (a
# TV beside the monitor), and its refresh rate for the layer, which does not read it. Each only
# when it is not given: SC_MONITOR=NAME|off, SC_FG_TARGET=RATE (environment or sc-turbo.conf).
display_settings() {
    local monitor rate
    [ -n "${SC_MONITOR:-}" ] && export SC_MONITOR
    if [ "${SC_MONITOR:-auto}" != off ] && [ -z "${WAYLANDDRV_PRIMARY_MONITOR:-}" ]; then
        monitor="$("$here/tools/sc-monitor" 2>/dev/null)"
        [ -n "$monitor" ] && export WAYLANDDRV_PRIMARY_MONITOR="$monitor"
    fi
    if [ -n "${SC_FG_TARGET:-}" ]; then
        export SC_FG_TARGET
    else
        rate="$("$here/tools/sc-monitor" rate 2>/dev/null)"
        case "$rate" in
        ''|*[!0-9.]*) ;;
        *) [ "${rate%%.*}" -ge 30 ] 2>/dev/null && [ "${rate%%.*}" -le 600 ] && export SC_FG_TARGET="$rate" ;;
        esac
    fi
    echo "Display: ${WAYLANDDRV_PRIMARY_MONITOR:-left to the runner}, ${SC_FG_TARGET:-120} Hz"
}
# A sched_ext scheduler while the game runs (tools/sc-sched follow): "sched=NAME[:MODE]" or SC_SCHED.
start_sched() {
    local s="${sc_sched:-${SC_SCHED:-}}" name mode
    [ -n "$s" ] && [ "$s" != stock ] || return 0
    name="${s%%:*}"; mode=gaming; [ "$s" != "$name" ] && mode="${s#*:}"
    if ! "$here/tools/sc-sched" allowed; then
        echo "CPU scheduler $name: not here (needs scx-scheds, scx-tools and switching without a password: docs/advanced-performance-tweaking.md); the stock one"
        return 0
    fi
    mkdir -p "$here/logs"
    nohup "$here/tools/sc-sched" follow "$name" "$mode" >> "$here/logs/sched.out" 2>&1 &
    echo "CPU scheduler: scx_$name ($mode) while the game runs, the stock one after it (log: logs/sched.out)"
}
# The CPU's hardware prefetchers off and huge pages on while the game runs (tools/sc-tune follow):
# SC_PREFETCH=off and SC_THP=on in sc-turbo.conf. Needs Myrddin's root helper, which a user sets up by
# hand (docs/advanced-performance-tweaking.md); nothing is switched without it, and nothing asks for a password.
start_tune() {
    local what=() said=()
    [ "${SC_PREFETCH:-on}" = off ] && { what+=(prefetch); said+=("the CPU's prefetchers off"); }
    [ "${SC_THP:-off}" = on ] && { what+=(thp); said+=("huge pages on"); }
    [ ${#what[@]} -gt 0 ] || return 0
    local text="${said[0]}"; [ ${#said[@]} -gt 1 ] && text="$text and ${said[1]}"
    if ! "$here/tools/sc-tune" allowed; then
        echo "NOTE: $text: not done, Myrddin's root helper is not set up here (docs/advanced-performance-tweaking.md)"
        return 0
    fi
    mkdir -p "$here/logs"
    nohup "$here/tools/sc-tune" follow "${what[@]}" >> "$here/logs/tune.out" 2>&1 &
    echo "While the game runs: $text; as before after it (log: logs/tune.out)"
}
logs="$here/logs/probe"

newest_log() { ls -t "$here"/logs/probe/probe-StarCitizen*.log "$here"/logs/capture/probe-StarCitizen*.log 2>/dev/null | head -1; }

# Parameters for the layer in the running game (the control file PARAMS, which it reads once a
# second and removes). What it has not read yet is kept and the new ones are added after it, so two
# changes within a second both arrive; of the same name the later one counts.
send_params() {
    mkdir -p "$here/logs/fg"
    { cat "$here/logs/fg/PARAMS" 2>/dev/null; printf '%s\n' "$@"; } > "$here/logs/fg/PARAMS.tmp" &&
        mv "$here/logs/fg/PARAMS.tmp" "$here/logs/fg/PARAMS"
}

case "${1:-}" in
probe|capture)
    if [ "$1" = capture ]; then
        mkdir -p "$here/logs/capture"
        logs="$here/logs/capture"
        # nothing is captured until "sc-turbo go": then 4 consecutive frames every 10 s, 12 times
        export SC_PROBE_CAPTURE=4 SC_PROBE_CAPTURE_EVERY=10 SC_PROBE_CAPTURE_BURSTS=12 SC_PROBE_CAPTURE_TRIGGER=1
        rm -f "$here/logs/capture/GO"
    fi
    [ -f "$here/build/libsc_probe.so" ] || { echo "build/libsc_probe.so is missing"; exit 1; }
    mkdir -p "$logs"
    export SC_PROBE=1 SC_PROBE_DIR="$logs"
    export VK_ADD_IMPLICIT_LAYER_PATH="$here/build${VK_ADD_IMPLICIT_LAYER_PATH:+:$VK_ADD_IMPLICIT_LAYER_PATH}"
    export DISABLE_LSFGVK=1     # keep lsfg-vk out of this run so the numbers are the game's own
    export WINE_SCHED_LOG=0     # the scheduling-call log is not needed and costs time
    need_launch
    desktop_notes
    echo "Probe logs: $logs"
    launch_now
    ;;
fg)
    [ -f "$here/build/fg/libsc_fg.so" ] || { echo "build/fg/libsc_fg.so is missing (./build.sh install)"; exit 1; }
    need_launch
    mkdir -p "$here/logs/fg"; rm -f "$here/logs/fg/OFF" "$here/logs/fg/DUMP" "$here/logs/fg/MULT" "$here/logs/fg/HUDOFF" "$here/logs/fg/HUDLAYEROFF" "$here/logs/fg/HUDSCAN" "$here/logs/fg/TRACE" "$here/logs/fg/LAYER" "$here/logs/fg/SCDON" "$here/logs/fg/NOCAP" "$here/logs/fg/EVENTS" "$here/logs/fg/PARAMS" "$here"/logs/fg/PARAMS.layer-*
    # (the number is optional: "sc-turbo fg hud" is x2 with MangoHud)
    case "${2:-}" in ''|*[!0-9]*) fg_mult=2; fg_words=("${@:2}") ;; *) fg_mult="$2"; fg_words=("${@:3}") ;; esac
    # 5x to 8x are experimental: only with SC_FG_EXPERIMENTAL=1 (sc-turbo.conf), which the layer reads
    # too: it makes room for that many generated frames when the game starts.
    multiplier_allowed "$fg_mult" || exit 1
    [ "${SC_FG_EXPERIMENTAL:-0}" = 1 ] && export SC_FG_EXPERIMENTAL=1
    export SC_FG=1 SC_FG_DIR="$here/logs/fg" SC_FG_MULT="$fg_mult"
    layer="$here/build/fg"
    # The HUD kept apart from what is generated: on unless sc-turbo.conf says SC_FG_KEEP_HUD=0. Off is
    # the control file that "sc-turbo fg-hud on" takes away again, so it can be switched in the game.
    [ "${SC_FG_KEEP_HUD:-1}" = 0 ] && touch "$here/logs/fg/HUDOFF"
    # HUD content that moves over the screen (markers, the compass, a flight display) is put where it
    # is on its way in every generated frame, unless "nomarkers" or sc-turbo.conf says otherwise.
    export SC_FG_MARKERS="${SC_FG_MARKERS:-1}"
    # A multiplier that follows the game's rate takes the fewest generated frames that fill the display,
    # with the game's own rate limited to an even part of the display's (a smoother picture), unless
    # sc-turbo.conf says SC_FG_FILL=0 (the window's "Performance" on): then the most that do not hold
    # the game back (the quickest response).
    export SC_FG_FILL="${SC_FG_FILL:-1}"
    for word in ${fg_words[@]+"${fg_words[@]}"}; do
        case "$word" in
        fixed) export SC_FG_ADAPT=0 ;;   # the multiplier is held at the number
        auto) export SC_FG_ADAPT=1 ;;    # it follows the game's rate, up to the number (what the layer does anyway)
        trace) export SC_FG_TRACE=1 ;;   # lets "sc-turbo fg-trace" record the frame structure
        hud) SC_MANGOHUD=1 ;;
        panel) export SC_FG_PANEL=1 ;;   # the layer's own panel (sc-turbo fg-panel); without the word there is none
        off) fg_off=1 ;;   # loaded with generation off (the OFF control file); fg-on switches it on
        markers) export SC_FG_MARKERS=1 ;;   # (what the launch does anyway; the word is still taken)
        watch) io_watch=1 ;;   # the recording of "sc-turbo iowatch", from outside the game
        sched=*) sc_sched="${word#sched=}" ;;   # the CPU scheduler while the game runs (start_sched)
        nomarkers) export SC_FG_MARKERS=0
            echo "Moving HUD content stays at the game's own rate (sc-turbo fg-params markers=1 switches it on in the running game)" ;;
        old|older)
            [ "$word" = old ] && layer="$here/build/fg-prev" || layer="$here/build/fg-prev2"
            [ -f "$layer/libsc_fg.so" ] || { echo "$layer/libsc_fg.so is missing"; exit 1; }
            echo "Using an earlier build ($layer)" ;;
        next)   # the newest build, before it is validated and installed: for a diagnosis, not for play
            layer="$here/build/fg-next"
            [ -f "$layer/libsc_fg.so" ] || { echo "$layer/libsc_fg.so is missing (./build.sh)"; exit 1; }
            echo "Using the newest build, which is not validated yet ($layer)" ;;
        *) echo "fg: \"$word\" is not known (fixed, hud, panel, off, nomarkers, watch, sched=NAME, trace, old, older, next)"; exit 1 ;;
        esac
    done
    [ "${fg_off:-0}" = 1 ] && touch "$here/logs/fg/OFF"
    # (This layer's folder comes first among the implicit layers, which puts it nearest the game:
    # every other layer, MangoHud among them, sees what this one presents.)
    export VK_ADD_IMPLICIT_LAYER_PATH="$layer${VK_ADD_IMPLICIT_LAYER_PATH:+:$VK_ADD_IMPLICIT_LAYER_PATH}"
    export DISABLE_LSFGVK=1 WINE_SCHED_LOG=0
    mangohud_on layer
    if [ "${SC_FG_PANEL:-0}" = 1 ]; then
        # The panel is there from the start: at the step it was left at, or the first one. The key
        # is the one of sc-turbo.conf (the layer's own default is Shift+7).
        panel_step=1; panel_corner=tl
        [ -f "$here/logs/fg/PANEL" ] && read -r panel_step panel_corner _ < "$here/logs/fg/PANEL"
        case "$panel_step" in [1-3]) ;; *) panel_step=1 ;; esac
        case "$panel_corner" in tl|tr|bl|br) ;; *) panel_corner=tl ;; esac
        if [ -n "${SC_FG_PANEL_KEY:-}" ] && ! panel_key_known "$SC_FG_PANEL_KEY"; then
            echo "NOTE: SC_FG_PANEL_KEY=$SC_FG_PANEL_KEY is no key the panel knows (like Shift+7, Ctrl+F9): Shift+7 it is"
            SC_FG_PANEL_KEY=
        fi
        export SC_FG_PANEL_KEY="${SC_FG_PANEL_KEY:-Shift+7}"
        echo "$panel_step $panel_corner $SC_FG_PANEL_KEY" > "$here/logs/fg/PANEL.tmp" && mv "$here/logs/fg/PANEL.tmp" "$here/logs/fg/PANEL"
    fi
    desktop_notes
    display_settings
    runner_note
    dlss_note
    if [ "${fg_off:-0}" = 1 ]; then
        echo "Frame generation off at the start (\"sc-turbo fg-on\" or the window switches it on, up to x$SC_FG_MULT); log: $here/logs/fg"
    else
        echo "Frame generation x$SC_FG_MULT; log: $here/logs/fg"
    fi
    [ "$SC_FG_MULT" -gt 4 ] 2>/dev/null &&
        echo "  Experimental (x5 and above): a smoother picture where the game's own rate is low, not a quicker one."
    [ "${SC_FG_PANEL:-0}" = 1 ] && echo "  The performance panel is shown; $SC_FG_PANEL_KEY in the game steps it on (more, then off)."
    if [ "${SC_FG_ADAPT:-1}" = 0 ]; then
        echo "  The multiplier is held at x$SC_FG_MULT (\"fixed\"); without that word it follows the game's rate, up to x$SC_FG_MULT."
    fi
    if [ "${SC_FG_ADAPT:-1}" != 0 ] && [ "$SC_FG_FILL" = 1 ]; then
        echo "  The game's own rate is limited where that fills the display evenly (Performance off); \"sc-turbo fg-params fill=0\" lets it run free."
    fi
    [ -e "$here/logs/fg/HUDOFF" ] && echo "  The HUD is not kept apart (SC_FG_KEEP_HUD=0); \"sc-turbo fg-hud on\" switches that on in the running game."
    if [ "${io_watch:-0}" = 1 ]; then
        mkdir -p "$here/logs/io"
        nohup "$here/tools/sc-iowatch" > "$here/logs/io/watch.out" 2>&1 &
        echo "Running with logs: the game's disk and memory use is noted from outside (afterwards: sc-turbo iowatch report)"
    fi
    start_sched
    start_tune
    launch_now
    ;;
run)
