#!/usr/bin/env python3
"""What bounds the game's own frame rate on this machine, measured from outside while it is played.

    tools/base-probe [SECONDS=20] [--pid PID] [--no-stacks] [--no-mem] [--keep-fg]
    tools/base-probe report DIR          print a finished measurement again

Two stretches of SECONDS each and a third of 10 s, in a busy place with a steady view:

  1. counters   per thread, by the CPU's own counters (perf stat, user mode only): how much of the
                time went by on P-cores and on E-cores, the clock it really ran at (is the power limit
                or heat holding it back), instructions per cycle, the share of cycles stalled on
                memory (what faster RAM could touch), the share spent walking page tables (what
                huge pages could touch), and how long threads waited for a CPU.
  2. stacks     sampled call stacks (perf record, user mode only): which module the time is in (the
                game, Wine, the graphics driver, this project's layer), which Wine functions the game
                calls into most, and how much of the game's own time sits in spin-wait loops.
  3. memory     sampled loads that had to wait for their data (perf record with the address read, user
                mode only): where the data came from (RAM, a fetch already under way, the L3 cache),
                which kind of memory it was (the game's own, and whether a huge page could hold it;
                files mapped from disk; the graphics driver's memory), and which code did the loads.

Nothing is attached to the game and nothing in it is changed: the counters and samples are taken by
the kernel (perf_event_open, no ptrace), the rest is read from /proc and /sys. The game's executable
is read from disk (never from memory) to tell spin loops from work. Frame generation is switched off
for the measurement, as the A/B tools do it, and back on afterwards (--keep-fg: left as it is).

Everything is kept in logs/base/probe-TIME/ (report.txt, the raw files).
"""
import bisect
import collections
import os
import re
import struct
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
FG_DIR = os.environ.get("FG_DIR", os.path.join(HERE, "logs/fg"))
COMM = os.environ.get("SC_COMM", "StarCitizen.exe")

CORE = ["cycles", "instructions", "ref-cycles", "cycle_activity.stalls_l3_miss", "cycle_activity.stalls_total",
        "mem_load_retired.l3_miss", "dtlb_load_misses.walk_active", "dtlb_store_misses.walk_active",
        "itlb_misses.walk_active"]
ATOM = ["cycles", "instructions", "ref-cycles", "mem_bound_stalls.load", "mem_bound_stalls.load_dram_hit",
        "mem_load_uops_retired.dram_hit"]


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def cpulist(text):
    out = set()
    for part in text.split(","):
        a, _, b = part.partition("-")
        if a.strip():
            out.update(range(int(a), int(b or a) + 1))
    return out


ONLINE = cpulist(read("/sys/devices/system/cpu/online", "0"))
ECORES = cpulist(read("/sys/devices/cpu_atom/cpus"))
PCORES = cpulist(read("/sys/devices/cpu_core/cpus")) or ONLINE
HYBRID = bool(ECORES)


def tsc_hz():
    for line in open("/proc/cpuinfo"):
        if line.startswith("bogomips"):
            return float(line.split(":")[1]) / 2 * 1e6
    return 0.0


def game_pid():
    best = None
    for d in os.listdir("/proc"):
        if d.isdigit() and read(f"/proc/{d}/comm") == COMM[:15]:
            try:
                n = len(os.listdir(f"/proc/{d}/task"))
            except OSError:
                continue
            if best is None or n > best[1]:
                best = (int(d), n)
    return best[0] if best else None


def threads(pid):
    out = {}
    try:
        tids = os.listdir(f"/proc/{pid}/task")
    except OSError:
        return out
    for tid in tids:
        name = read(f"/proc/{pid}/task/{tid}/comm")
        if name:
            out[int(tid)] = name
    return out


def group(pid, tid, name):
    if tid == pid:
        return "main thread"
    for prefix, label in (("BatchWorker", "BatchWorkers"), ("BackgroundWorke", "BackgroundWorkers"), ("Physics", "Physics"),
                          ("CAudioThread", "Audio"), ("vkd3d", "vkd3d"), ("sc_fg", "layer (sc_fg)"), ("Network", "Network")):
        if name.startswith(prefix):
            return label
    return "other"


def schedstat(pid, tids):
    out = {}
    for tid in tids:
        f = read(f"/proc/{pid}/task/{tid}/schedstat").split()
        s = read(f"/proc/{pid}/task/{tid}/stat")
        if len(f) == 3 and s:
            rest = s[s.rindex(")") + 2:].split()
            out[tid] = (int(f[0]), int(f[1]), int(f[2]), int(rest[11]), int(rest[12]))  # run ns, wait ns, slices, utime, stime
    return out


def cpu_times():
    out = {}
    for line in open("/proc/stat"):
        f = line.split()
        if f[0].startswith("cpu") and f[0] != "cpu":
            v = [int(x) for x in f[1:9]]
            out[int(f[0][3:])] = (sum(v), v[3] + v[4])
    return out


def freq(cpu):
    base = f"/sys/devices/system/cpu/cpu{cpu}/cpufreq/"
    return int(read(base + "cpuinfo_avg_freq") or read(base + "scaling_cur_freq") or 0) / 1e6


def throttle():
    base = "/sys/devices/system/cpu/cpu0/thermal_throttle/"
    return {k: int(read(base + k, "0") or 0) for k in ("package_throttle_count", "package_throttle_total_time_ms", "core_throttle_count")}


def temperature():
    for d in os.listdir("/sys/class/hwmon"):
        h = f"/sys/class/hwmon/{d}"
        if read(h + "/name") == "coretemp":
            return int(read(h + "/temp1_input", "0")) / 1000
    return 0.0


def io_counts(pid):
    """Bytes the process asked to read (page cache included), bytes that came from a disk, page faults."""
    out = {}
    for line in read(f"/proc/{pid}/io").splitlines():
        k, _, v = line.partition(":")
        out[k] = int(v)
    s = read(f"/proc/{pid}/stat")
    if s:
        f = s[s.rindex(")") + 2:].split()
        out["minflt"], out["majflt"] = int(f[7]), int(f[9])
    return out


def gpu_memory(pid):
    try:
        r = subprocess.run(["nvidia-smi", "--query-gpu=memory.used,memory.total", "--format=csv,noheader,nounits"], capture_output=True, text=True, timeout=5)
        used, total = [int(x) for x in r.stdout.strip().split(",")]
        return used, total
    except (OSError, ValueError, subprocess.SubprocessError):
        return None


class Out:
    def __init__(self, path):
        self.f = open(path, "w")

    def __call__(self, text=""):
        print(text, flush=True)
        self.f.write(text + "\n")
        self.f.flush()


