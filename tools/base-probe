# stretch 1: counters

def counters(pid, secs, out_dir, say):
    names = threads(pid)
    before = schedstat(pid, names)
    time.sleep(1.0)
    mid = schedstat(pid, names)
    hz = os.sysconf("SC_CLK_TCK")
    busy = [t for t in names if t in before and t in mid and (mid[t][3] + mid[t][4] - before[t][3] - before[t][4]) / hz > 0.02]
    chosen = sorted(set(busy) | {t for t, n in names.items() if group(pid, t, n) in ("main thread", "BatchWorkers", "Physics")})
    if HYBRID:  # groups: the events of one group count over the same moments, so their ratios are exact
        g1 = "{" + ",".join(f"cpu_core/{e}/u" for e in CORE[:6]) + "}"
        g2 = "{cpu_core/cycles/u," + ",".join(f"cpu_core/{e}/u" for e in CORE[6:]) + "}"
        g3 = "{" + ",".join(f"cpu_atom/{e}/u" for e in ATOM) + "}"
        events = [g1, g2, g3]
    else:
        events = ["{" + ",".join(e + ":u" for e in CORE[:6]) + "}", "{cycles:u," + ",".join(e + ":u" for e in CORE[6:]) + "}"]
    csv = os.path.join(out_dir, "stat.csv")
    cmd = ["perf", "stat", "--no-scale", "-x", ";", "--per-thread", "-t", ",".join(map(str, chosen)), "-e", ",".join(events), "-o", csv, "--", "sleep", str(secs)]
    say(f"stretch 1: counters on {len(chosen)} of {len(names)} threads for {secs:.0f} s")
    start = schedstat(pid, names)
    c0, t0, th0, io0 = cpu_times(), time.time(), throttle(), io_counts(pid)
    p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
    fsum, fn, temps, where = collections.Counter(), collections.Counter(), [], collections.Counter()
    while p.poll() is None:
        time.sleep(0.25)
        for c in ONLINE:
            v = freq(c)
            if v:
                fsum[c] += v
                fn[c] += 1
        temps.append(temperature())
        s = read(f"/proc/{pid}/task/{pid}/stat")
        if s:
            where[int(s[s.rindex(")") + 2:].split()[36])] += 1
    err = p.stderr.read()
    wall = time.time() - t0
    end, c1, th1, io1 = schedstat(pid, names), cpu_times(), throttle(), io_counts(pid)
    if p.returncode != 0 or not os.path.exists(csv):
        say(f"perf stat failed (exit {p.returncode}): " + err.strip()[:400])
        return
    # --- per thread: (group, event) -> raw count, and the time (s) that group was counting
    val = collections.defaultdict(dict)
    ran = collections.defaultdict(dict)
    seen = collections.defaultdict(int)
    for line in open(csv):
        f = line.rstrip("\n").split(";")
        if len(f) < 5 or line.startswith("#"):
            continue
        m = re.match(r"(.*)-(\d+)$", f[0])
        if not m:
            continue
        t, e = int(m.group(2)), f[3]
        if e.endswith("cycles/u") and "ref-" not in e or e == "cycles:u":
            seen[t] += 1  # every group starts with cycles: 1 = P counters, 2 = P page walks, 3 = E counters
        gi = seen[t] if HYBRID else seen[t]
        try:
            val[t][(gi, e)] = float(f[1])
            ran[t][gi] = float(f[4]) / 1e9
        except ValueError:
            pass  # <not counted>: the thread never ran on that kind of core
    tsc = tsc_hz()

    def ev(tids, gi, name):
        return sum(val[t].get((gi, name), 0.0) for t in tids)

    def ran_s(tids, gi):
        return sum(ran[t].get(gi, 0.0) for t in tids)

    groups = collections.defaultdict(list)
    for t in chosen:
        groups[group(pid, t, names.get(t, "?"))].append(t)
    order = ["main thread", "BatchWorkers", "Physics", "Audio", "BackgroundWorkers", "vkd3d", "Network", "layer (sc_fg)", "other"]
    busy_cpu = {c: 1 - (c1[c][1] - c0[c][1]) / max(c1[c][0] - c0[c][0], 1) for c in ONLINE if c in c0 and c in c1}
    bp = [c for c in PCORES if busy_cpu.get(c, 0) > 0.5 and fn[c]]
    be = [c for c in ECORES if busy_cpu.get(c, 0) > 0.5 and fn[c]]
    say()
    say(f"the machine in that stretch: {sum(busy_cpu.values()):.1f} of {len(ONLINE)} CPUs busy "
        f"(P {sum(busy_cpu[c] for c in PCORES if c in busy_cpu):.1f} of {len(PCORES)}, E {sum(busy_cpu[c] for c in ECORES if c in busy_cpu):.1f} of {len(ECORES)}); "
        f"package {max(temps, default=0):.0f} C at most; heat throttling {th1['package_throttle_count'] - th0['package_throttle_count']} times "
        f"({th1['package_throttle_total_time_ms'] - th0['package_throttle_total_time_ms']} ms)")
    if io0 and io1:
        d = lambda k: (io1.get(k, 0) - io0.get(k, 0)) / wall
        gm = gpu_memory(pid)
        say(f"streaming in that stretch: the game read {d('rchar') / 1e6:.1f} MB/s ({d('read_bytes') / 1e6:.1f} from the disk, the rest from the page cache) in {d('syscr'):.0f} reads/s; "
            f"{d('minflt') / 1e3:.1f} thousand page faults/s" + (f"; GPU memory in use {gm[0]} of {gm[1]} MB (everything on the card)" if gm else ""))
    if bp:
        say(f"clock of the busy CPUs (sysfs): P {sum(fsum[c] / fn[c] for c in bp) / len(bp):.2f} GHz (slowest {min(fsum[c] / fn[c] for c in bp):.2f}; 5.10 is the most)"
            + (f", E {sum(fsum[c] / fn[c] for c in be) / len(be):.2f} GHz (3.90 the most)" if be else ""))
    say()
    say("per kind of thread (user mode). cores = CPUs' worth of time; E = share of that time on E-cores; GHz = the clock it")
    say("ran at; IPC = instructions per cycle; mem = cycles stalled waiting for RAM (P: L3 miss outstanding, E: load from RAM);")
    say("tlb = cycles walking page tables (P only); wait = time ready but without a CPU, against time running")
    say(f"  {'threads':<19}{'n':>3} {'cores':>6} {'E %':>5} | {'P GHz':>5} {'P IPC':>5} {'mem %':>5} {'stall %':>7} {'tlb %':>5} | {'E GHz':>5} {'E IPC':>5} {'mem %':>5} | {'wait %':>6} {'slices/s':>8}")
    rows = {}
    for g in order + ["all counted"]:
        tids = groups.get(g) if g != "all counted" else chosen
        if not tids:
            continue
        pre, suf = ("cpu_core/", "/u") if HYBRID else ("", ":u")
        cc, ci, cr = ev(tids, 1, f"{pre}cycles{suf}"), ev(tids, 1, f"{pre}instructions{suf}"), ev(tids, 1, f"{pre}ref-cycles{suf}")
        l3 = ev(tids, 1, f"{pre}cycle_activity.stalls_l3_miss{suf}")
        st = ev(tids, 1, f"{pre}cycle_activity.stalls_total{suf}")
        l3n = ev(tids, 1, f"{pre}mem_load_retired.l3_miss{suf}")
        wc = ev(tids, 2, f"{pre}cycles{suf}")
        walk = sum(ev(tids, 2, f"{pre}{e}{suf}") for e in CORE[6:])
        ac, ai, ar = ev(tids, 3, "cpu_atom/cycles/u"), ev(tids, 3, "cpu_atom/instructions/u"), ev(tids, 3, "cpu_atom/ref-cycles/u")
        adram, dram = ev(tids, 3, "cpu_atom/mem_bound_stalls.load_dram_hit/u"), ev(tids, 3, "cpu_atom/mem_load_uops_retired.dram_hit/u")
        run = sum(end[t][0] - start[t][0] for t in tids if t in end and t in start) / 1e9
        wait = sum(end[t][1] - start[t][1] for t in tids if t in end and t in start) / 1e9
        slices = sum(end[t][2] - start[t][2] for t in tids if t in end and t in start)
        te, tp1 = ran_s(tids, 3), ran_s(tids, 1)   # time on E-cores; time the P group counted
        tp = max(run - te, tp1) if tp1 else 0.0    # time on P-cores: the kernel's run time less the E time
        up = tp / tp1 if tp1 else 0.0              # (what the P group missed, if the counters had to take turns)
        rows[g] = dict(tp=tp, te=te, run=run, counted=tp1 + ran_s(tids, 2) + te, l3n=l3n * up, dram=dram)
        pct = lambda a, b: f"{100 * a / b:.1f}" if b else "-"
        num = lambda a, b, fmt="{:.2f}": fmt.format(a / b) if b else "-"
        say(f"  {g:<19}{len(tids):>3} {(tp + te) / wall:>6.2f} {pct(te, tp + te):>5} | {num(cc, cr / tsc * 1e9 if tsc else 0):>5} {num(ci, cc):>5} {pct(l3, cc):>5} {pct(st, cc):>7} {pct(walk, wc):>5} | "
            f"{num(ac, ar / tsc * 1e9 if tsc else 0):>5} {num(ai, ac):>5} {pct(adram, ac):>5} | {pct(wait, run):>6} {slices / wall:>8.0f}")
    a = rows.get("all counted")
    if a:
        say()
        say(f"check: {a['run'] / wall:.2f} CPUs' worth of run time by the kernel's accounting; the three counter groups were counting for {a['counted'] / wall:.2f}")
        say("       (the two P-core groups take turns on the same four counters, so the two figures should be close)")
        say(f"loads that had to come from RAM: {(a['l3n'] + a['dram']) / wall / 1e6:.1f} million a second "
            f"(at 64 bytes each {(a['l3n'] + a['dram']) * 64 / wall / 1e9:.2f} GB/s; prefetched and written data not included, so the real traffic is higher)")
    m = rows.get("main thread")
    if m:
        on_e = sum(n for c, n in where.items() if c in ECORES) / max(sum(where.values()), 1)
        say(f"main thread: last seen on an E-core in {100 * on_e:.0f} % of {sum(where.values())} looks")
    say()


