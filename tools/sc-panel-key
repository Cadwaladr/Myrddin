#!/usr/bin/env python3
"""The key that steps the performance panel: a desktop shortcut that runs "sc-turbo fg-panel"
(off -> shown rate -> and the game's -> and the pacing graph -> off). The desktop takes the key,
not the game: nothing is sent to the game and nothing in it is read.

    tools/sc-panel-key                    what is set up
    tools/sc-panel-key install [KEYS]     set it up; KEYS like Ctrl+Shift+grave (the default: Ctrl+Shift+`)
    tools/sc-panel-key remove             take it out again

KDE Plasma: a command shortcut as System Settings > Shortcuts > "Add New > Command" makes one: a
small .desktop file in ~/.local/share/applications and the key registered with Plasma's shortcut
service over D-Bus (which keeps it in ~/.config/kglobalshortcutsrc itself).
COSMIC: an entry in ~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom (where its
Settings > Keyboard > Custom shortcuts are kept; the desktop reads the file again at once).
The file as it was is kept in backups/ of this project. Any other desktop: this prints the
command to bind there by hand. (SC_PANEL_KEY_DESKTOP=kde|cosmic: that one, whatever is running.)
"""
import os, re, shlex, subprocess, sys, time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
COMMAND = os.path.join(HERE, "sc-turbo") + " fg-panel"
# (SC_PANEL_KEY_FILE: another file, to try this out on a copy)
FILE = os.environ.get("SC_PANEL_KEY_FILE") or os.path.expanduser("~/.config/cosmic/com.system76.CosmicSettings.Shortcuts/v1/custom")
NOTE = "Star Citizen performance panel"
MODIFIERS = {"ctrl": "Ctrl", "control": "Ctrl", "shift": "Shift", "alt": "Alt", "super": "Super"}
KEYS = {"`": "grave", "~": "grave", "backtick": "grave", "tilde": "grave"}
# One entry of the file: "(modifiers: [..], key: "..", description: ..): Action,"
ENTRY = re.compile(r'[ \t]*\(\s*modifiers:\s*\[([^\]]*)\],\s*(?:key:\s*"([^"]*)",\s*)?(?:description:\s*[^\n]*\n\s*)?\):\s*([^\n]*),\n')


def entries(text):
    for m in ENTRY.finditer(text):
        mods = sorted(x.strip() for x in m.group(1).split(",") if x.strip())
        yield m, mods, m.group(2) or "", m.group(3)


def ours(text):
    return [(m, mods, key) for m, mods, key, action in entries(text) if "sc-turbo fg-panel" in action]


def parse(keys):
    parts = [p for p in keys.replace(" ", "").split("+") if p] if keys != "+" else ["+"]
    mods, key = [], None
    for p in parts:
        if p.lower() in MODIFIERS:
            mods.append(MODIFIERS[p.lower()])
        elif key is None:
            key = KEYS.get(p.lower(), p)
        else:
            sys.exit(f"{keys}: more than one key")
    if not key:
        sys.exit(f"{keys}: no key")
    return sorted(set(mods)), key


# ----------------------------------------------------------------------------- KDE Plasma

KDE_ID = "net.local.sc-turbo-panel.desktop"
KDE_FILE = os.path.expanduser("~/.local/share/applications/" + KDE_ID)
KDE_ACTION = [KDE_ID, "_launch", NOTE, NOTE]
QT_MODIFIERS = {"Shift": 0x02000000, "Ctrl": 0x04000000, "Alt": 0x08000000, "Super": 0x10000000}
QT_NAMES = {"grave": 0x60, "space": 0x20, "tab": 0x01000001, "minus": 0x2D, "equal": 0x3D, "comma": 0x2C,
            "period": 0x2E, "slash": 0x2F, "semicolon": 0x3B, "apostrophe": 0x27, "backslash": 0x5C}
# What the key gives with Shift held (US layout): Plasma may know the shortcut by that sign.
SHIFTED = {0x60: 0x7E, 0x2D: 0x5F, 0x3D: 0x2B, 0x2C: 0x3C, 0x2E: 0x3E, 0x2F: 0x3F, 0x3B: 0x3A, 0x27: 0x22,
           0x5C: 0x7C, **{ord(a): ord(b) for a, b in zip("1234567890", "!@#$%^&*()")}}


def kde_call(method, signature, *args):
    """A call to Plasma's shortcut service; its answer as words, None when it cannot be reached."""
    try:
        done = subprocess.run(["busctl", "--user", "call", "org.kde.kglobalaccel", "/kglobalaccel",
                               "org.kde.KGlobalAccel", method, signature, *[str(a) for a in args]],
                              capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None
    return shlex.split(done.stdout) if done.returncode == 0 else None


def kde_codes(mods, key):
    """The key as Plasma numbers it (Qt's key codes), in every form it may know it by."""
    if key in QT_NAMES:
        code = QT_NAMES[key]
    elif re.fullmatch(r"[Ff]([1-9]|1[0-9]|2[0-4])", key):
        code = 0x01000030 + int(key[1:]) - 1
    elif len(key) == 1 and key.isascii() and key.isalnum():
        code = ord(key.upper())
    else:
        sys.exit(f"{key}: not a key this tool can name for Plasma (letters, digits, F1-F24, {', '.join(sorted(QT_NAMES))})")
    mask = 0
    for m in mods:
        mask |= QT_MODIFIERS[m]
    codes = [mask | code]
    if "Shift" in mods and code in SHIFTED:
        codes += [(mask & ~QT_MODIFIERS["Shift"]) | SHIFTED[code], mask | SHIFTED[code]]
    return codes


def kde_text(code):
    names = {v: k for k, v in QT_NAMES.items()}
    names.update({v: chr(v) for v in SHIFTED.values()})
    key = code & 0x01FFFFFF
    text = names.get(key) or (f"F{key - 0x01000030 + 1}" if 0x01000030 <= key <= 0x01000047 else chr(key) if 32 < key < 127 else hex(key))
    return "+".join([m for m in ("Ctrl", "Shift", "Alt", "Super") if code & QT_MODIFIERS[m]] + [text])


def kde_keys():
    """The keys registered for the panel: Qt key codes (empty: none); None: the service cannot be reached."""
    answer = kde_call("shortcutKeys", "as", 4, *KDE_ACTION)
    if answer is None or len(answer) < 2 or answer[0] != "a(ai)":
        return None
    # a(ai) N  then per sequence: 4 k1 k2 k3 k4
    numbers = [int(x) for x in answer[2:]]
    return [numbers[i + 1] for i in range(0, len(numbers), 5) if numbers[i + 1]]


def kde_main(what, keys):
    if what == "show":
        now = kde_keys()
        if now is None:
            print("Plasma's shortcut service does not answer (org.kde.kglobalaccel)")
        elif now and os.path.exists(KDE_FILE):
            print(" / ".join(kde_text(k) for k in now) + "  ->  " + COMMAND)
        else:
            print("no key is set up (tools/sc-panel-key install)")
    elif what == "remove":
        if not os.path.exists(KDE_FILE) and not kde_keys():
            print("no key was set up")
            return
        kde_call("setForeignShortcutKeys", "asa(ai)", 4, *KDE_ACTION, 0)
        kde_call("unregister", "ss", KDE_ID, "_launch")
        if os.path.exists(KDE_FILE):
            os.remove(KDE_FILE)
        subprocess.run(["kbuildsycoca6"], capture_output=True)
        print("removed")
    elif what == "install":
        mods, key = parse(keys or "Ctrl+Shift+grave")
        codes = kde_codes(mods, key)
        if kde_call("allMainComponents", "") is None:
            sys.exit("Plasma's shortcut service does not answer (org.kde.kglobalaccel): nothing set up")
        for code in codes:
            free = kde_call("isGlobalShortcutAvailable", "is", code, KDE_ID)
            if free != ["b", "true"]:
                taken = kde_call("getGlobalShortcutsByKey", "i", code) or []
                sys.exit(f"{kde_text(code)} is already taken in Plasma ({' '.join(taken[2:6]) or 'by another shortcut'}): nothing set up")
        rc = os.path.expanduser("~/.config/kglobalshortcutsrc")
        if os.path.exists(rc):
            keep = os.path.join(HERE, "backups")
            os.makedirs(keep, exist_ok=True)
            with open(rc) as f, open(os.path.join(keep, "kglobalshortcutsrc." + time.strftime("%Y%m%d-%H%M%S")), "w") as g:
                g.write(f.read())
        os.makedirs(os.path.dirname(KDE_FILE), exist_ok=True)
        with open(KDE_FILE + ".tmp", "w") as f:
            f.write("[Desktop Entry]\nExec=" + " ".join(shlex.quote(p) for p in [os.path.join(HERE, "sc-turbo"), "fg-panel"]) +
                    f"\nName={NOTE}\nNoDisplay=true\nStartupNotify=false\nType=Application\n"
                    "X-KDE-GlobalAccel-CommandShortcut=true\n")
        os.replace(KDE_FILE + ".tmp", KDE_FILE)
        subprocess.run(["kbuildsycoca6"], capture_output=True) # (so that Plasma finds the new entry)
        kde_call("doRegister", "as", 4, *KDE_ACTION)
        sequences = []
        for code in codes:
            sequences += [4, code, 0, 0, 0]
        kde_call("setForeignShortcutKeys", "asa(ai)", 4, *KDE_ACTION, len(codes), *sequences)
        now = kde_keys()
        if not now or set(now) != set(codes):
            sys.exit("Plasma did not take the key (it reads back as " + (" / ".join(kde_text(k) for k in now) if now else "none") +
                     "). The entry is there: set the key in System Settings > Shortcuts > " + NOTE)
        print(" / ".join(kde_text(k) for k in now) + "  ->  " + COMMAND)
    else:
        print(__doc__)


def manual():
    print("This desktop's shortcuts are not known to this tool. Bind a key of your choice to this command")
    print("in its keyboard settings (custom shortcut):")
    print("    " + COMMAND)


def write(text, before):
    if text.count("(") != text.count(")") or text.count("[") != text.count("]") or text.count("{") != text.count("}"):
        sys.exit("the result would not be well formed: nothing written")
    if before is not None:
        keep = os.path.join(HERE, "backups")
        os.makedirs(keep, exist_ok=True)
        name = os.path.join(keep, "cosmic-shortcuts-custom." + time.strftime("%Y%m%d-%H%M%S"))
        n = 1
        while os.path.exists(name + ("" if n == 1 else f"-{n}")): # (never over an earlier one)
            n += 1
        with open(name + ("" if n == 1 else f"-{n}"), "w") as f:
            f.write(before)
    tmp = FILE + ".sc-turbo-tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, FILE)


def main():
    what = sys.argv[1] if len(sys.argv) > 1 else "show"
    desktop = (os.environ.get("SC_PANEL_KEY_DESKTOP") or os.environ.get("XDG_CURRENT_DESKTOP", "")).upper()
    if "KDE" in desktop:
        kde_main(what, sys.argv[2] if len(sys.argv) > 2 else None)
        return
    if "COSMIC" not in desktop and not os.environ.get("SC_PANEL_KEY_FILE"):
        manual()
        return
    text = open(FILE).read() if os.path.exists(FILE) else None
    mine = ours(text) if text else []
    if what == "show":
        if mine:
            for _, mods, key in mine:
                print("+".join(mods + [key]) + "  ->  " + COMMAND)
        else:
            print("no key is set up (tools/sc-panel-key install)")
    elif what == "remove":
        if not mine:
            print("no key was set up")
            return
        new = text
        for m, _, _ in reversed(mine):
            new = new[: m.start()] + new[m.end() :]
        write(new, text)
        print("removed")
    elif what == "install":
        mods, key = parse(sys.argv[2] if len(sys.argv) > 2 else "Ctrl+Shift+grave")
        new = text if text is not None else "{\n}"
        for m, _, _ in reversed(ours(new)):
            new = new[: m.start()] + new[m.end() :]
        for _, other_mods, other_key, action in entries(new):
            if other_mods == mods and other_key == key and action != "Disable":
                sys.exit("+".join(mods + [key]) + f" is already taken there ({action}): nothing written")
        entry = "    (\n        modifiers: [\n" + "".join(f"            {m},\n" for m in mods) + "        ],\n"
        entry += f'        key: "{key}",\n        description: Some("{NOTE}"),\n    ): Spawn("{COMMAND}"),\n'
        end = new.rstrip().rfind("}")
        if end < 0:
            sys.exit(FILE + " is not what was expected: nothing written")
        head = new[:end]
        if head.strip() != "{" and not head.rstrip().endswith(","):
            head = head.rstrip() + ",\n"
        new = head + entry + new[end:]
        if len(list(entries(new))) != len(list(entries(text or ""))) - len(mine) + 1:
            sys.exit("the result does not read back as expected: nothing written")
        write(new, text)
        print("+".join(mods + [key]) + "  ->  " + COMMAND)
    else:
        print(__doc__)


main()
