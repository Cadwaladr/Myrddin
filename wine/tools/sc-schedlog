#!/usr/bin/env python3
"""
sc-schedlog -- summarize the WINE_SCHED_LOG=1 output of the patched kernelbase.dll.

Shows which scheduling calls the game made (CPU sets, EcoQoS, priorities, ideal
processors), grouped by thread name with numbers folded (BatchWorker3 -> BatchWorker#).

  sc-schedlog                                   # default: the LUG prefix's sc-launch.log
  sc-schedlog /path/to/sc-launch.log
"""

import collections
import os
import re
import sys


def prefix():
    """The Wine prefix the game is installed in: SC_PREFIX in the environment, else in the
    project's sc-turbo.conf, else the LUG Helper's default."""
    found = os.environ.get("SC_PREFIX")
    conf = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))), "sc-turbo.conf")
    if not found and os.path.exists(conf):
        for line in open(conf, encoding="utf-8"):
            name, _, value = line.strip().partition("=")
            if name == "SC_PREFIX":
                found = os.path.expandvars(value.strip().strip('"').strip("'"))
    return found or os.path.expanduser("~/Games/star-citizen")


DEFAULT_LOG = os.path.join(prefix(), "sc-launch.log")

DESC = re.compile(r"wine-sched: tid ([0-9a-f]+) SetThreadDescription L\"(.*)\" \(by [0-9a-f]+\)$")
CALL = re.compile(r"wine-sched: tid ([0-9a-f]+) (.*?) +\(by [0-9a-f]+\) (\S+)(?: (.*))?$")
PROC = re.compile(r"wine-sched: (SetProcessDefaultCpuSets|SetPriorityClass) (.*)$")
MODE = re.compile(r"wine-sched: cpusets (.*)$")


def group(name):
    return re.sub(r"\d+", "#", name.strip()) or "-"


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else DEFAULT_LOG
    lines = open(path, encoding="utf-8", errors="replace").read().splitlines()

    names = {}
    for line in lines:
        m = DESC.search(line)
        if m:
            names[m.group(1)] = m.group(2)

    calls = collections.defaultdict(collections.Counter)  # (call, group) -> Counter(args)
    threads = collections.defaultdict(set)
    process_calls = collections.Counter()
    modes = collections.Counter()
    for line in lines:
        if DESC.search(line):
            continue
        m = CALL.search(line)
        if m:
            tid, name, call, args = m.group(1), m.group(2).strip(), m.group(3), (m.group(4) or "")
            if name == "-":
                name = names.get(tid, "-")
            if call in ("power", "memory"):  # "power throttling ...", "memory priority N"
                word, _, args = args.partition(" ")
                call = f"{call} {word}"
            key = (call, group(name))
            calls[key][args] += 1
            threads[key].add(tid)
            continue
        m = PROC.search(line)
        if m:
            process_calls[f"{m.group(1)} {re.sub(r'process [0-9A-Fa-fx]+ ', '', m.group(2))}"] += 1
            continue
        m = MODE.search(line)
        if m:
            modes[m.group(1)] += 1

    if not (calls or process_calls or modes):
        sys.exit(f"no wine-sched lines in {path} (launch with WINE_SCHED_LOG=1 and the patched runner)")

    for mode, n in modes.items():
        print(f"processes started with: {mode}  (x{n})")
    if process_calls:
        print("\nprocess-wide calls:")
        for c, n in process_calls.most_common():
            print(f"  {n:6d}  {c}")
    if calls:
        print(f"\n{'call':28} {'thread group':24} {'threads':>7} {'calls':>7}  arguments (most common first)")
        for (call, grp), args in sorted(calls.items(), key=lambda kv: (kv[0][0], -sum(kv[1].values()))):
            shown = ", ".join(f"{a or '-'} x{n}" for a, n in args.most_common(4))
            if len(args) > 4:
                shown += f", ... ({len(args)} distinct)"
            print(f"{call:28} {grp[:24]:24} {len(threads[(call, grp)]):7d} {sum(args.values()):7d}  {shown}")


if __name__ == "__main__":
    main()
