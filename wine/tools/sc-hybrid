#!/usr/bin/env python3
"""
sc-hybrid -- hybrid-CPU (P-core / E-core) thread placement for Star Citizen under Wine.

Why this exists
---------------
StarCitizen.exe imports the Windows CPU Sets API (GetSystemCpuSetInformation,
SetThreadSelectedCpuSets) and thread priority / power throttling calls, and Windows
11's scheduler additionally keeps foreground/high-priority threads on P-cores.
Under stock Wine all of that is lost: SetThreadSelectedCpuSets is a stub and Wine
only maps thread priorities to nice values when RLIMIT_NICE allows it.  Measured on
an i5-13600K, the game's main thread spent 25-46% of its time on E-cores and
migrated ~500 times per second.  (The patched kernelbase.dll in this project
implements CPU sets; WINE_SCHED_LOG=1 shows which calls the game really makes.)

This tool needs no root and never touches the game's memory or code: it only calls
sched_setaffinity()/setpriority() on the game's threads, the same thing
`taskset -p` / `renice` do.  Threads whose affinity was set by the game or by
Wine (anything other than "all CPUs") are left alone.

Commands
--------
  sc-hybrid run     [--wait [--while-pid PID]] [--policy P] ...
                                                apply placement until the game exits
  sc-hybrid status  [--seconds N]               measure where the game's threads run
  sc-hybrid undo                                give every thread all CPUs again
  sc-hybrid topology                            show detected P/E cores

Policies (--policy)
-------------------
  main        (default) main thread -> P-cores, background service threads -> E-cores
  main-only   only the main thread -> P-cores
  off         touch nothing (baseline for A/B testing)
"""

import argparse
import os
import re
import sys
import time

GAME_COMM = "StarCitizen.exe"

# Linux truncates thread names to 15 characters; these are prefixes of the names
# Star Citizen gives its latency-insensitive service threads.  BatchWorkers
# (the job system), Physics, audio, input, network and the NVIDIA driver's
# Vulkan threads are deliberately NOT in this list.
BACKGROUND_PREFIXES = (
    "BackgroundWorke",   # background job pool (69 threads, mostly idle)
    "CAnalyticsQueue",
    "ZLibCompressor",
    "Bink IO", "BinkAsy",
    "HttpManagerThre",
    "WebRTCWorkerThr", "WebRTCNetworkTh", "rtc-low-prio",
    "LibwebsocketsTh", "ThreadedTickWeb",
    "CServicesThread", "CCIGServices",
    "Discipline_Clie",
    "Low Priority Ev",
    "WatchdogThread",
    "EncoderQueue", "DecodingQueue",
    "GFxMeshCacheRes",
    "dxvk-cache", "vkd3d-disk",
)


# --------------------------------------------------------------------------- #
# topology


def parse_cpulist(text):
    cpus = set()
    for part in text.strip().split(","):
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            cpus.update(range(int(a), int(b) + 1))
        else:
            cpus.add(int(part))
    return cpus


def fmt_cpulist(cpus):
    cpus = sorted(cpus)
    out, start, prev = [], None, None
    for c in cpus:
        if start is None:
            start = prev = c
        elif c == prev + 1:
            prev = c
        else:
            out.append(f"{start}-{prev}" if start != prev else str(start))
            start = prev = c
    if start is not None:
        out.append(f"{start}-{prev}" if start != prev else str(start))
    return ",".join(out)


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read()
    except OSError:
        return default


def detect_topology():
    """Return (pcores, ecores, method).  E-cores is empty on non-hybrid CPUs."""
    core = read("/sys/devices/cpu_core/cpus")
    atom = read("/sys/devices/cpu_atom/cpus")
    if core and atom:
        return parse_cpulist(core), parse_cpulist(atom), "intel-hybrid PMU"
    # Fallback: group by maximum frequency (also catches AMD Zen 5c hybrids).
    online = parse_cpulist(read("/sys/devices/system/cpu/online", "0"))
    freq = {}
    for c in online:
        f = read(f"/sys/devices/system/cpu/cpu{c}/cpufreq/cpuinfo_max_freq")
        if f:
            freq[c] = int(f)
    if freq and len(set(freq.values())) > 1:
        top = max(freq.values())
        p = {c for c, f in freq.items() if f >= top * 0.95}
        return p, set(freq) - p, "max-frequency"
    return online, set(), "uniform"


# --------------------------------------------------------------------------- #
# process / thread helpers


def find_game_pid():
    for d in os.listdir("/proc"):
        if not d.isdigit():
            continue
        if (read(f"/proc/{d}/comm") or "").strip() == GAME_COMM:
            # the Wine main thread is the thread group leader
            return int(d)
    return None


def threads(pid):
    try:
        tids = os.listdir(f"/proc/{pid}/task")
    except OSError:
        return []
    out = []
    for t in tids:
        name = read(f"/proc/{pid}/task/{t}/comm")
        if name is not None:
            out.append((int(t), name.strip()))
    return out


def classify(pid, tid, name):
    if tid == pid:
        return "main"
    if name.startswith(BACKGROUND_PREFIXES):
        return "background"
    return "other"


def thread_stat(pid, tid):
    s = read(f"/proc/{pid}/task/{tid}/stat")
    if not s:
        return None
    f = s.rsplit(")", 1)[1].split()
    # fields after ')' start at index 0 == field 3 (state)
    return {"utime": int(f[11]), "stime": int(f[12]), "nice": int(f[16]), "cpu": int(f[36])}


# --------------------------------------------------------------------------- #
# run


class Governor:
    def __init__(self, pid, pcores, ecores, policy, renice, dry_run, verbose):
        self.pid, self.pcores, self.ecores = pid, pcores, ecores
        self.allcpus = pcores | ecores
        self.policy, self.renice = policy, renice
        self.dry_run, self.verbose = dry_run, verbose
        self.applied = {}      # tid -> mask we set
        self.foreign = set()   # tids someone else restricted; leave alone
        self.reniced = set()

    def target(self, cls):
        if self.policy == "off" or not self.ecores:
            return None
        if cls == "main":
            return self.pcores
        if cls == "background" and self.policy == "main":
            return self.ecores
        return None

    def apply_once(self):
        changed = 0
        for tid, name in threads(self.pid):
            cls = classify(self.pid, tid, name)
            want = self.target(cls)
            if want is None or tid in self.foreign:
                continue
            try:
                cur = os.sched_getaffinity(tid)
            except OSError:
                continue
            if cur == want:
                self.applied[tid] = want
                continue
            # Only take over threads that still run everywhere or that we set
            # ourselves; anything else was restricted by the game or Wine
            # (e.g. a CPU-set aware Wine build) and is respected.
            if cur != self.allcpus and self.applied.get(tid) != cur:
                self.foreign.add(tid)
                if self.verbose:
                    print(f"[sc-hybrid] leaving {tid} {name!r} alone (affinity {fmt_cpulist(cur)} set by someone else)")
                continue
            if self.dry_run:
                print(f"[sc-hybrid] would set {tid} {name!r} ({cls}) -> {fmt_cpulist(want)}")
            else:
                try:
                    os.sched_setaffinity(tid, want)
                except OSError as e:
                    if self.verbose:
                        print(f"[sc-hybrid] {tid} {name!r}: {e}")
                    continue
            self.applied[tid] = want
            changed += 1
            if cls == "background" and self.renice and tid not in self.reniced and not self.dry_run:
                try:
                    cur_nice = os.getpriority(os.PRIO_PROCESS, tid)
                    if cur_nice < self.renice:
                        os.setpriority(os.PRIO_PROCESS, tid, self.renice)
                except OSError:
                    pass
                self.reniced.add(tid)
        # forget dead threads
        live = {t for t, _ in threads(self.pid)}
        for d in (self.applied, ):
            for t in list(d):
                if t not in live:
                    del d[t]
        self.foreign &= live
        self.reniced &= live
        return changed


def cmd_run(args, pcores, ecores):
    if not ecores and args.policy != "off":
        print("[sc-hybrid] no E-cores detected; nothing to do on this CPU.")
        return 0
    pid = find_game_pid()
    if pid is None and args.wait:
        print("[sc-hybrid] waiting for StarCitizen.exe ...", flush=True)
        while pid is None:
            # stop waiting once the launch script is gone; a running game is still
            # governed until it exits
            if args.while_pid and not os.path.exists(f"/proc/{args.while_pid}"):
                print(f"[sc-hybrid] pid {args.while_pid} has exited; stopping.", flush=True)
                return 0
            time.sleep(2)
            pid = find_game_pid()
    if pid is None:
        print("[sc-hybrid] StarCitizen.exe is not running.")
        return 1
    print(f"[sc-hybrid] pid {pid}: policy={args.policy} P-cores={fmt_cpulist(pcores)} "
          f"E-cores={fmt_cpulist(ecores)} renice-background={args.renice_background}", flush=True)
    gov = Governor(pid, pcores, ecores, args.policy, args.renice_background, args.dry_run, args.verbose)
    total = 0
    while os.path.exists(f"/proc/{pid}"):
        n = gov.apply_once()
        total += n
        if n and args.verbose:
            print(f"[sc-hybrid] placed {n} threads (total {total})", flush=True)
        if args.once or args.dry_run:
            break
        time.sleep(args.interval)
    print(f"[sc-hybrid] done ({total} placements).", flush=True)
    return 0


def cmd_undo(args, pcores, ecores):
    pid = find_game_pid()
    if pid is None:
        print("[sc-hybrid] StarCitizen.exe is not running.")
        return 1
    allcpus = pcores | ecores
    n = 0
    for tid, _ in threads(pid):
        try:
            if os.sched_getaffinity(tid) != allcpus:
                os.sched_setaffinity(tid, allcpus)
                n += 1
        except OSError:
            pass
    print(f"[sc-hybrid] reset affinity of {n} threads to {fmt_cpulist(allcpus)}"
          " (nice values cannot be lowered again without RLIMIT_NICE).")
    return 0


# --------------------------------------------------------------------------- #
# status / measurement


def cmd_status(args, pcores, ecores):
    pid = find_game_pid()
    if pid is None:
        print("[sc-hybrid] StarCitizen.exe is not running.")
        return 1
    hz = os.sysconf("SC_CLK_TCK")
    groups = {}
    ths = threads(pid)
    names = dict(ths)
    start = {t: thread_stat(pid, t) for t, _ in ths}
    sched0 = read(f"/proc/{pid}/task/{pid}/schedstat", "0 0 0").split()
    st0 = read(f"/proc/{pid}/task/{pid}/sched", "")
    mig0 = int((re.search(r"se\.nr_migrations\s*:\s*(\d+)", st0) or [0, 0])[1])
    oncpu = {}  # tid -> [samples on P, samples on E]
    t_end = time.time() + args.seconds
    while time.time() < t_end:
        for t, _ in ths:
            s = read(f"/proc/{pid}/task/{t}/stat")
            if not s:
                continue
            f = s.rsplit(")", 1)[1].split()
            if f[0] != "R":
                continue
            c = int(f[36])
            slot = oncpu.setdefault(t, [0, 0])
            slot[0 if c in pcores else 1] += 1
        time.sleep(0.01)
    end = {t: thread_stat(pid, t) for t, _ in ths}
    sched1 = read(f"/proc/{pid}/task/{pid}/schedstat", "0 0 0").split()
    st1 = read(f"/proc/{pid}/task/{pid}/sched", "")
    mig1 = int((re.search(r"se\.nr_migrations\s*:\s*(\d+)", st1) or [0, 0])[1])

    for t, name in ths:
        a, b = start.get(t), end.get(t)
        if not a or not b:
            continue
        cpu = (b["utime"] + b["stime"] - a["utime"] - a["stime"]) / hz / args.seconds * 100
        cls = classify(pid, t, name)
        key = "MAIN THREAD" if cls == "main" else re.sub(r"\d+$", "", name)
        g = groups.setdefault(key, {"n": 0, "cpu": 0.0, "p": 0, "e": 0, "nice": set(), "cls": cls, "aff": set()})
        g["n"] += 1
        g["cpu"] += cpu
        p, e = oncpu.get(t, [0, 0])
        g["p"] += p
        g["e"] += e
        g["nice"].add(b["nice"])
        try:
            g["aff"].add(fmt_cpulist(os.sched_getaffinity(t)))
        except OSError:
            pass

    print(f"Star Citizen pid {pid}, {len(ths)} threads, sampled {args.seconds}s   "
          f"P-cores {fmt_cpulist(pcores)}  E-cores {fmt_cpulist(ecores) or '-'}")
    oncpu_ns = int(sched1[0]) - int(sched0[0])
    wait_ns = int(sched1[1]) - int(sched0[1])
    print(f"main thread: on-cpu {oncpu_ns / 1e7 / args.seconds:5.1f}%   runnable-but-waiting "
          f"{wait_ns / 1e7 / args.seconds:4.1f}%   migrations {(mig1 - mig0) / args.seconds:6.0f}/s")
    print(f"{'thread group':<18} {'n':>3} {'cpu%':>7} {'on E-cores':>10}  {'nice':<8} affinity")
    for key, g in sorted(groups.items(), key=lambda kv: -kv[1]["cpu"]):
        if g["cpu"] < args.min_cpu and key != "MAIN THREAD":
            continue
        tot = g["p"] + g["e"]
        epct = f"{100 * g['e'] / tot:5.1f}%" if tot else "    -"
        nice = ",".join(str(n) for n in sorted(g["nice"]))
        aff = " | ".join(sorted(g["aff"]))[:40]
        print(f"{key:<18} {g['n']:>3} {g['cpu']:7.1f} {epct:>10}  {nice:<8} {aff}")
    return 0


def main():
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--pcores", help="override detected P-cores, e.g. 0-11")
    common.add_argument("--ecores", help="override detected E-cores, e.g. 12-19")
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                 parents=[common])
    sub = ap.add_subparsers(dest="cmd")
    r = sub.add_parser("run", help="apply placement until the game exits", parents=[common])
    r.add_argument("--wait", action="store_true", help="wait for StarCitizen.exe to start")
    r.add_argument("--while-pid", type=int, metavar="PID",
                   help="with --wait: stop waiting when process PID (e.g. the launch script) is gone")
    r.add_argument("--policy", choices=("main", "main-only", "off"), default="main")
    r.add_argument("--interval", type=float, default=2.0, help="rescan interval in seconds (default 2)")
    r.add_argument("--renice-background", type=int, default=0, metavar="N",
                   help="also raise background threads' nice to N (cannot be undone without RLIMIT_NICE)")
    r.add_argument("--once", action="store_true", help="apply once and exit")
    r.add_argument("--dry-run", action="store_true")
    r.add_argument("-v", "--verbose", action="store_true")
    s = sub.add_parser("status", help="measure where the game's threads run", parents=[common])
    s.add_argument("--seconds", type=float, default=10.0)
    s.add_argument("--min-cpu", type=float, default=1.0, help="hide groups below this CPU%% (default 1)")
    sub.add_parser("undo", help="give every game thread all CPUs again", parents=[common])
    sub.add_parser("topology", help="show detected P/E cores", parents=[common])
    args = ap.parse_args()

    pcores, ecores, method = detect_topology()
    if args.pcores:
        pcores = parse_cpulist(args.pcores)
    if args.ecores is not None:
        ecores = parse_cpulist(args.ecores)

    if args.cmd == "topology" or args.cmd is None:
        print(f"detection: {method}\nP-cores: {fmt_cpulist(pcores)}\nE-cores: {fmt_cpulist(ecores) or '(none)'}")
        if args.cmd is None:
            ap.print_usage()
        return 0
    return {"run": cmd_run, "status": cmd_status, "undo": cmd_undo}[args.cmd](args, pcores, ecores)


if __name__ == "__main__":
    sys.exit(main())
