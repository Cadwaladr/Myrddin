#!/usr/bin/env python3
"""
sc-levelstats -- summarize Star Citizen's own level_stats_*.csv files for A/B tests.

The game writes one level_stats_<pid>.csv per session into its LIVE directory with
frame time histograms for the main thread and the whole frame.  This prints one
line per session (oldest first) so runs with different settings can be compared.

  sc-levelstats                      # default LIVE directory of this install
  sc-levelstats --min-entities 20000 # only real in-game sessions (not menus)
  sc-levelstats --label FILE=label   # tag sessions, e.g. level_stats_2268.csv=stock

Compare like with like: the numbers are whole-session averages, so a session in
a city and one in space are not comparable.  Load the same location, stay a
similar time, then compare "whole" ms and the share of frames slower than 33 ms.
"""

import argparse
import glob
import os
import sys
import time

def prefix():
    """The Wine prefix the game is installed in: SC_PREFIX in the environment, else in the
    project's sc-turbo.conf, else the LUG Helper's default."""
    found = os.environ.get("SC_PREFIX")
    conf = os.path.join(os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__)))), "sc-turbo.conf")
    if not found and os.path.exists(conf):
        for line in open(conf, encoding="utf-8"):
            name, _, value = line.strip().partition("=")
            if name == "SC_PREFIX":
                found = os.path.expandvars(value.strip().strip('"').strip("'"))
    return found or os.path.expanduser("~/Games/star-citizen")


DEFAULT_DIR = os.path.join(prefix(), "drive_c/Program Files/Roberts Space Industries/StarCitizen/LIVE")
BUCKETS = ("<16", "<20", "<25", "<30", "<35", "<40", "<45", "<50", "slower")


def ms(field):
    """'36.0 FPS (27.7 ms)' -> 27.7"""
    try:
        return float(field.split("(")[1].split("ms")[0])
    except (IndexError, ValueError):
        return float("nan")


def pct(field):
    try:
        return float(field.strip().rstrip("%"))
    except ValueError:
        return 0.0


def parse(path):
    with open(path, encoding="utf-8", errors="replace") as f:
        rows = [line.rstrip("\n").split(";") for line in f if line.strip()]
    out = []
    for r in rows[2:]:
        if len(r) < 34:
            continue
        main = [pct(x) for x in r[14:23]]
        whole = [pct(x) for x in r[25:34]]
        out.append({
            "frames": int(r[2] or 0),
            "entities": int(float(r[4] or 0)),
            "ws_gb": float(r[11].split()[0]) / 1024 if r[11] else 0.0,
            "main_ms": ms(r[13]),
            "whole_ms": ms(r[24]),
            # buckets are frame time ranges; >=35 ms covers everything at or below ~28 FPS
            "main_slow": sum(main[5:]),
            "whole_slow": sum(whole[5:]),
            "whole_smooth": whole[0] + whole[1],
        })
    return out


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("dir", nargs="?", default=DEFAULT_DIR)
    ap.add_argument("--min-entities", type=int, default=0)
    ap.add_argument("--label", action="append", default=[], metavar="FILE=LABEL")
    args = ap.parse_args()

    labels = dict(x.split("=", 1) for x in args.label if "=" in x)
    files = sorted(glob.glob(os.path.join(args.dir, "level_stats_*.csv")), key=os.path.getmtime)
    if not files:
        sys.exit(f"no level_stats_*.csv in {args.dir}")

    print(f"{'session end':16} {'file':22} {'frames':>7} {'entities':>8} {'RAM GB':>6} "
          f"{'main ms':>7} {'whole ms':>8} {'FPS':>5} {'<20ms':>6} {'>=35ms':>6}  label")
    for path in files:
        name = os.path.basename(path)
        for s in parse(path):
            if s["entities"] < args.min_entities:
                continue
            when = time.strftime("%Y-%m-%d %H:%M", time.localtime(os.path.getmtime(path)))
            fps = 1000 / s["whole_ms"] if s["whole_ms"] > 0 else 0
            print(f"{when:16} {name:22} {s['frames']:7d} {s['entities']:8d} {s['ws_gb']:6.1f} "
                  f"{s['main_ms']:7.1f} {s['whole_ms']:8.1f} {fps:5.1f} {s['whole_smooth']:5.1f}% "
                  f"{s['whole_slow']:5.1f}%  {labels.get(name, '')}")


if __name__ == "__main__":
    main()
