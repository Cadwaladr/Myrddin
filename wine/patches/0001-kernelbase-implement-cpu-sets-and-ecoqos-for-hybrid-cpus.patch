@@ -613,6 +621,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetThreadPriority( HANDLE thread, INT priority )
  */
 BOOL WINAPI DECLSPEC_HOTPATCH SetThreadPriorityBoost( HANDLE thread, BOOL disable )
 {
+    SCHED_TRACE( thread, "SetThreadPriorityBoost disable=%d", disable );
     return set_ntstatus( NtSetInformationThread( thread, ThreadPriorityBoost, &disable, sizeof(disable) ));
 }
 
@@ -645,12 +654,18 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetThreadStackGuarantee( ULONG *size )
 BOOL WINAPI DECLSPEC_HOTPATCH SetThreadInformation( HANDLE thread, THREAD_INFORMATION_CLASS info_class,
         VOID *info, DWORD size )
 {
+    NTSTATUS status;
+
     switch (info_class)
     {
         case ThreadMemoryPriority:
+            if (info && size == sizeof(MEMORY_PRIORITY_INFORMATION))
+                SCHED_TRACE( thread, "memory priority %lu", ((MEMORY_PRIORITY_INFORMATION *)info)->MemoryPriority );
             return set_ntstatus( NtSetInformationThread( thread, ThreadPagePriority, info, size ));
         case ThreadPowerThrottling:
-            return set_ntstatus( NtSetInformationThread( thread, ThreadPowerThrottlingState, info, size ));
+            status = NtSetInformationThread( thread, ThreadPowerThrottlingState, info, size );
+            if (!status) cpuset_set_power_throttling( thread, info );
