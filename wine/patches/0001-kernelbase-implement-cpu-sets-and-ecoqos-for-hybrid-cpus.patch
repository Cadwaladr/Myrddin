From: starcitizen-wine-optimization
Subject: [PATCH] kernelbase: Implement CPU sets and EcoQoS steering for hybrid CPUs.

SetThreadSelectedCpuSets() and SetProcessDefaultCpuSets() were stubs, and
SetThreadInformation(ThreadPowerThrottling) had no effect, so games that place
their threads on performance cores (Star Citizen imports these APIs) ran their
critical threads on E-cores under Wine.

CPU set selections are translated into thread affinity masks.  On hybrid CPUs
(GetSystemCpuSetInformation reports more than one EfficiencyClass) the default
"class" mode widens a selection to all logical processors of the named
efficiency class(es), so the host scheduler can still balance inside the class.
As on Windows, a thread selection overrides the process default, a NULL/empty
selection clears it, and a conflicting SetThreadAffinityMask() wins.  Threads
that request EcoQoS (execution speed throttling) and have no selection are
steered to the efficient cores.  Non-hybrid systems keep the old behaviour.

Runtime switches (read once per process):
  WINE_CPUSETS=class|exact|0   default class; exact = hard pinning; 0 = stub behaviour
  WINE_ECOQOS=0                don't steer EcoQoS threads
  WINE_SCHED_LOG=1             log CPU set / priority / ideal processor / thread name
                               calls to stderr, independent of WINEDEBUG

Applies to wine-11.20 (and the LUG lug-wine-tkg 11.20 runners, which ship
upstream kernelbase sources).
---
  dlls/kernelbase/kernelbase.h |  17 +++
  dlls/kernelbase/memory.c     | 294 ++++++++++++++++++++++++++++++++++++++++++-
  dlls/kernelbase/process.c    |   2 +
  dlls/kernelbase/thread.c     |  17 ++-
  4 files changed, 327 insertions(+), 3 deletions(-)

diff --git a/dlls/kernelbase/kernelbase.h b/dlls/kernelbase/kernelbase.h
index e46ca0f..8d01248 100644
--- a/dlls/kernelbase/kernelbase.h
+++ b/dlls/kernelbase/kernelbase.h
@@ -51,6 +51,23 @@ static inline BOOL set_ntstatus( NTSTATUS status )
     return !status;
 }
 
+/* CPU sets / hybrid CPU scheduling support (memory.c) */
+#ifndef THREAD_POWER_THROTTLING_EXECUTION_SPEED
+#define THREAD_POWER_THROTTLING_EXECUTION_SPEED 0x1
+#endif
+extern BOOL sched_log_enabled(void);
+extern DWORD sched_thread_id( HANDLE thread );
+extern const char *sched_thread_desc( HANDLE thread, char *buf, DWORD size );
+extern void cpuset_init_thread( HANDLE process, HANDLE thread );
+extern void cpuset_set_power_throttling( HANDLE thread, const THREAD_POWER_THROTTLING_STATE *state );
+
+/* WINE_SCHED_LOG=1: log scheduling related calls, independently of WINEDEBUG */
+#define SCHED_TRACE( thread, fmt, ... ) \
+    do { if (sched_log_enabled()) { char desc_[64]; \
+        MESSAGE( "wine-sched: tid %04lx %-15s (by %04lx) " fmt "\n", sched_thread_id( thread ), \
+                 sched_thread_desc( thread, desc_, sizeof(desc_) ), GetCurrentThreadId(), ##__VA_ARGS__ ); \
+    } } while (0)
+
 /* make the kernel32 names available */
 #define HeapAlloc(heap, flags, size) RtlAllocateHeap(heap, flags, size)
 #define HeapReAlloc(heap, flags, ptr, size) RtlReAllocateHeap(heap, flags, ptr, size)
diff --git a/dlls/kernelbase/memory.c b/dlls/kernelbase/memory.c
index 2ce2dca..120d5a3 100644
--- a/dlls/kernelbase/memory.c
+++ b/dlls/kernelbase/memory.c
@@ -1553,13 +1553,274 @@ BOOL WINAPI GetSystemCpuSetInformation(SYSTEM_CPU_SET_INFORMATION *info, ULONG b
 }
 
 
+/***********************************************************************
+ * CPU Sets
+ *
+ * There is no host scheduler notion of CPU sets, so a CPU set selection is
+ * turned into a thread affinity mask.  On hybrid CPUs (more than one
+ * EfficiencyClass reported by GetSystemCpuSetInformation) the default "class"
+ * mode widens a selection to every logical processor of the efficiency
+ * class(es) it names.  That keeps the application's intent ("run this on
+ * performance cores") while leaving the host scheduler free to balance the
+ * thread inside that class.  As on Windows, a conflicting affinity mask wins
+ * over CPU sets.
+ *
+ *   WINE_CPUSETS=class   default: honour selections per efficiency class
+ *   WINE_CPUSETS=exact   honour selections exactly (hard pinning)
+ *   WINE_CPUSETS=0       ignore selections (old stub behaviour)
+ *   WINE_ECOQOS=0        don't move EcoQoS (power throttled) threads to E-cores
+ *   WINE_SCHED_LOG=1     log scheduling related calls to stderr
+ */
+
+#define CPUSET_MAX_CPUS    64     /* processor group 0 only */
+#define CPUSET_MAX_THREADS 2048
+
+enum cpuset_mode { CPUSET_OFF, CPUSET_CLASS, CPUSET_EXACT };
+
+struct cpuset_thread
+{
+    DWORD     tid;
+    BOOL      ecoqos;     /* thread asked for EcoQoS */
+    KAFFINITY base;       /* affinity the thread had before we changed it */
+    KAFFINITY selected;   /* thread selected CPU sets, 0 if none */
+    KAFFINITY applied;    /* mask we last applied, 0 if none */
+};
+
+static INIT_ONCE cpuset_once = INIT_ONCE_STATIC_INIT;
+static SRWLOCK cpuset_lock = SRWLOCK_INIT;
+static enum cpuset_mode cpuset_mode = CPUSET_CLASS;
+static BOOL cpuset_ecoqos = TRUE, cpuset_hybrid, sched_log;
+static ULONG cpuset_count;
+static ULONG cpuset_ids[CPUSET_MAX_CPUS];
+static BYTE cpuset_cpu[CPUSET_MAX_CPUS];
+static BYTE cpuset_class[CPUSET_MAX_CPUS];
+static KAFFINITY cpuset_all, cpuset_efficient;
+static KAFFINITY process_default_cpusets;
+static struct cpuset_thread cpuset_threads[CPUSET_MAX_THREADS];
+static BOOL cpuset_used;  /* cpuset_threads has entries */
+
+static BOOL env_value( const char *name, char *buf, DWORD size )
+{
+    DWORD len = GetEnvironmentVariableA( name, buf, size );
+    return len && len < size;
+}
+
+static BOOL WINAPI init_cpusets( INIT_ONCE *once, void *param, void **context )
+{
+    HANDLE process = GetCurrentProcess();
+    SYSTEM_CPU_SET_INFORMATION *info, *p;
+    BYTE min_class = 0xff, max_class = 0;
+    ULONG len = 0, i;
+    char buf[16];
+
+    if (env_value( "WINE_CPUSETS", buf, sizeof(buf) ))
+    {
+        if (!_stricmp( buf, "exact" )) cpuset_mode = CPUSET_EXACT;
+        else if (!strcmp( buf, "0" ) || !_stricmp( buf, "off" )) cpuset_mode = CPUSET_OFF;
+        else cpuset_mode = CPUSET_CLASS;
+    }
+    if (env_value( "WINE_ECOQOS", buf, sizeof(buf) ) && buf[0] == '0') cpuset_ecoqos = FALSE;
+    if (env_value( "WINE_SCHED_LOG", buf, sizeof(buf) ) && buf[0] != '0') sched_log = TRUE;
+
+    NtQuerySystemInformationEx( SystemCpuSetInformation, &process, sizeof(process), NULL, 0, &len );
+    if (len && (info = HeapAlloc( GetProcessHeap(), 0, len )))
+    {
+        if (!NtQuerySystemInformationEx( SystemCpuSetInformation, &process, sizeof(process), info, len, &len ))
+        {
+            for (p = info; (char *)p < (char *)info + len && p->Size; p = (void *)((char *)p + p->Size))
+            {
+                if (p->Type != CpuSetInformation || p->CpuSet.Group) continue;
+                if (p->CpuSet.LogicalProcessorIndex >= CPUSET_MAX_CPUS || cpuset_count >= CPUSET_MAX_CPUS) continue;
+                cpuset_ids[cpuset_count] = p->CpuSet.Id;
+                cpuset_cpu[cpuset_count] = p->CpuSet.LogicalProcessorIndex;
+                cpuset_class[cpuset_count] = p->CpuSet.EfficiencyClass;
+                cpuset_all |= (KAFFINITY)1 << p->CpuSet.LogicalProcessorIndex;
+                min_class = min( min_class, p->CpuSet.EfficiencyClass );
+                max_class = max( max_class, p->CpuSet.EfficiencyClass );
+                cpuset_count++;
+            }
+        }
+        HeapFree( GetProcessHeap(), 0, info );
+    }
+    cpuset_hybrid = cpuset_count && min_class != max_class;
+    for (i = 0; i < cpuset_count; i++)
+        if (cpuset_class[i] == min_class) cpuset_efficient |= (KAFFINITY)1 << cpuset_cpu[i];
+
+    if (sched_log)
+        MESSAGE( "wine-sched: cpusets mode=%s ecoqos=%d hybrid=%d cpus=%lu all=%#Ix efficient=%#Ix\n",
+                 cpuset_mode == CPUSET_OFF ? "off" : cpuset_mode == CPUSET_EXACT ? "exact" : "class",
+                 cpuset_ecoqos, cpuset_hybrid, cpuset_count, cpuset_all, cpuset_efficient );
+    return TRUE;
+}
+
+static void init_cpusets_once(void)
+{
+    InitOnceExecuteOnce( &cpuset_once, init_cpusets, NULL, NULL );
+}
+
+BOOL sched_log_enabled(void)
+{
+    init_cpusets_once();
+    return sched_log;
+}
+
+DWORD sched_thread_id( HANDLE thread )
+{
+    return thread == GetCurrentThread() ? GetCurrentThreadId() : GetThreadId( thread );
+}
+
+const char *sched_thread_desc( HANDLE thread, char *buf, DWORD size )
+{
+    WCHAR *desc = NULL;
+
+    buf[0] = 0;
+    if (SUCCEEDED( GetThreadDescription( thread, &desc )) && desc)
+    {
+        if (!WideCharToMultiByte( CP_UTF8, 0, desc, -1, buf, size, NULL, NULL )) buf[0] = 0;
+        LocalFree( desc );
+    }
+    return buf[0] ? buf : "-";
+}
+
+/* translate CPU set ids to an affinity mask according to the current mode;
+ * unknown ids (e.g. from other processor groups) are ignored */
+static KAFFINITY cpuset_ids_to_mask( const ULONG *ids, ULONG count, char *list, DWORD list_size )
+{
+    KAFFINITY mask = 0, classes = 0, ret = 0;
+    DWORD pos = 0;
+    ULONG i, j;
+
+    if (list_size) list[0] = 0;
+    for (i = 0; ids && i < count; i++)
+    {
+        for (j = 0; j < cpuset_count; j++) if (cpuset_ids[j] == ids[i]) break;
+        if (list && pos + 8 < list_size)
+        {
+            if (j < cpuset_count)
+                pos += snprintf( list + pos, list_size - pos, "%s%u", pos ? "," : "", cpuset_cpu[j] );
+            else
+                pos += snprintf( list + pos, list_size - pos, "%s?%#lx", pos ? "," : "", ids[i] );
+        }
+        if (j == cpuset_count) continue;
+        mask |= (KAFFINITY)1 << cpuset_cpu[j];
+        classes |= (KAFFINITY)1 << min( cpuset_class[j], 63 );
+    }
+    if (cpuset_mode != CPUSET_CLASS) return mask;
+    if (!mask || !cpuset_hybrid) return mask ? cpuset_all : 0;
+    for (j = 0; j < cpuset_count; j++)
+        if (classes & ((KAFFINITY)1 << min( cpuset_class[j], 63 ))) ret |= (KAFFINITY)1 << cpuset_cpu[j];
+    return ret;
+}
+
+/* entries are never removed (open addressing); an entry whose fields are all zero
+ * is equivalent to no entry, which is how the state of an exited thread is dropped */
+static struct cpuset_thread *cpuset_get_thread( DWORD tid, BOOL create )
+{
+    ULONG i, start = (tid >> 2) % CPUSET_MAX_THREADS;
+
+    for (i = start; ; )
+    {
+        if (cpuset_threads[i].tid == tid) return &cpuset_threads[i];
+        if (!cpuset_threads[i].tid)
+        {
+            if (!create) return NULL;
+            cpuset_threads[i].tid = tid;
+            cpuset_used = TRUE;
+            return &cpuset_threads[i];
+        }
+        if ((i = (i + 1) % CPUSET_MAX_THREADS) == start) return NULL;
+    }
+}
+
+/* recompute and apply the scheduling mask of a thread; cpuset_lock must be held */
+static void cpuset_update_thread( HANDLE thread, struct cpuset_thread *t, KAFFINITY current )
+{
+    KAFFINITY want;
+
+    /* somebody else changed the affinity since we last touched it: new baseline */
+    if (current != t->applied) t->base = current;
+
+    want = t->selected ? t->selected : process_default_cpusets ? process_default_cpusets : cpuset_all;
+    if (t->ecoqos && !t->selected && cpuset_ecoqos && cpuset_hybrid && (want & cpuset_efficient))
+        want &= cpuset_efficient;
+    want &= t->base;  /* a conflicting affinity mask wins, like on Windows */
+    if (!want) want = t->base;
+
+    if (want != current && NtSetInformationThread( thread, ThreadAffinityMask, &want, sizeof(want) ))
+        want = current;
+    t->applied = want;
+}
+
+/* look up a thread of the current process and update it; cpuset_lock must be held */
+static BOOL cpuset_refresh_thread( HANDLE thread, BOOL *selected, KAFFINITY sel_mask, int ecoqos, BOOL new_thread )
+{
+    THREAD_BASIC_INFORMATION tbi;
+    struct cpuset_thread *t;
+
+    if (NtQueryInformationThread( thread, ThreadBasicInformation, &tbi, sizeof(tbi), NULL )) return FALSE;
+    if (HandleToULong( tbi.ClientId.UniqueProcess ) != GetCurrentProcessId()) return FALSE;
+    /* a new thread only needs an entry if there is a process default to apply */
+    if (!(t = cpuset_get_thread( HandleToULong( tbi.ClientId.UniqueThread ),
+                                 !new_thread || process_default_cpusets ))) return FALSE;
+    if (new_thread)  /* thread ids are recycled: forget whatever an exited thread left behind */
+    {
+        t->ecoqos = FALSE;
+        t->base = t->selected = t->applied = 0;
+    }
+    if (selected) t->selected = sel_mask;
+    if (ecoqos != -1) t->ecoqos = ecoqos;
+    cpuset_update_thread( thread, t, tbi.AffinityMask );
+    return TRUE;
+}
+
+/* called by CreateRemoteThreadEx() for a new, still suspended thread */
+void cpuset_init_thread( HANDLE process, HANDLE thread )
+{
+    if (!cpuset_used) return;  /* fast path: the process never used CPU sets or EcoQoS */
+    if (process != GetCurrentProcess() && GetProcessId( process ) != GetCurrentProcessId()) return;
+    RtlAcquireSRWLockExclusive( &cpuset_lock );
+    cpuset_refresh_thread( thread, NULL, 0, -1, TRUE );
+    RtlReleaseSRWLockExclusive( &cpuset_lock );
+}
+
+/* called by SetThreadInformation( ThreadPowerThrottling ) */
+void cpuset_set_power_throttling( HANDLE thread, const THREAD_POWER_THROTTLING_STATE *state )
+{
+    BOOL eco = (state->ControlMask & THREAD_POWER_THROTTLING_EXECUTION_SPEED) &&
+               (state->StateMask & THREAD_POWER_THROTTLING_EXECUTION_SPEED);
+
+    init_cpusets_once();
+    SCHED_TRACE( thread, "power throttling version %lu control %#lx state %#lx -> %s", state->Version,
+                 state->ControlMask, state->StateMask, eco ? "EcoQoS" : "normal" );
+    if (cpuset_mode == CPUSET_OFF || !cpuset_ecoqos || !cpuset_hybrid) return;
+    RtlAcquireSRWLockExclusive( &cpuset_lock );
+    cpuset_refresh_thread( thread, NULL, 0, eco, FALSE );
+    RtlReleaseSRWLockExclusive( &cpuset_lock );
+}
+
+
 /***********************************************************************
  *           SetThreadSelectedCpuSets   (kernelbase.@)
  */
 BOOL WINAPI SetThreadSelectedCpuSets(HANDLE thread, const ULONG *cpu_set_ids, ULONG count)
 {
-    FIXME( "thread %p, cpu_set_ids %p, count %lu stub.\n", thread, cpu_set_ids, count );
+    BOOL selected = TRUE;
+    KAFFINITY mask;
+    char list[256];
 
+    TRACE( "thread %p, cpu_set_ids %p, count %lu.\n", thread, cpu_set_ids, count );
+
+    init_cpusets_once();
+    mask = cpuset_ids_to_mask( cpu_set_ids, count, list, sizeof(list) );
+    SCHED_TRACE( thread, "SetThreadSelectedCpuSets cpus [%s] -> mask %#Ix", list, mask );
+
+    if (cpuset_mode == CPUSET_OFF) return TRUE;
+    if (cpu_set_ids && count && !mask) return TRUE;  /* only unknown ids */
+    if (cpuset_mode == CPUSET_CLASS && !cpuset_hybrid) return TRUE;  /* nothing to steer */
+
+    RtlAcquireSRWLockExclusive( &cpuset_lock );
+    cpuset_refresh_thread( thread, &selected, mask, -1, FALSE );
+    RtlReleaseSRWLockExclusive( &cpuset_lock );
     return TRUE;
 }
 
@@ -1569,8 +1830,37 @@ BOOL WINAPI SetThreadSelectedCpuSets(HANDLE thread, const ULONG *cpu_set_ids, UL
  */
 BOOL WINAPI SetProcessDefaultCpuSets(HANDLE process, const ULONG *cpu_set_ids, ULONG count)
 {
-    FIXME( "process %p, cpu_set_ids %p, count %lu stub.\n", process, cpu_set_ids, count );
+    HANDLE thread = NULL, next;
+    KAFFINITY mask;
+    char list[256];
 
+    TRACE( "process %p, cpu_set_ids %p, count %lu.\n", process, cpu_set_ids, count );
+
+    init_cpusets_once();
+    mask = cpuset_ids_to_mask( cpu_set_ids, count, list, sizeof(list) );
+    if (sched_log)
+        MESSAGE( "wine-sched: SetProcessDefaultCpuSets process %p cpus [%s] -> mask %#Ix\n", process, list, mask );
+
+    if (cpuset_mode == CPUSET_OFF) return TRUE;
+    if (cpu_set_ids && count && !mask) return TRUE;
+    if (cpuset_mode == CPUSET_CLASS && !cpuset_hybrid) return TRUE;
+    if (process != GetCurrentProcess() && GetProcessId( process ) != GetCurrentProcessId())
+    {
+        FIXME( "process %p, cpu_set_ids %p, count %lu: other processes not supported.\n", process, cpu_set_ids, count );
+        return TRUE;
+    }
+
+    RtlAcquireSRWLockExclusive( &cpuset_lock );
+    process_default_cpusets = mask;
+    while (!NtGetNextThread( GetCurrentProcess(), thread, THREAD_QUERY_INFORMATION | THREAD_SET_INFORMATION,
+                             0, 0, &next ))
+    {
+        if (thread) NtClose( thread );
+        thread = next;
+        cpuset_refresh_thread( thread, NULL, 0, -1, FALSE );
+    }
+    if (thread) NtClose( thread );
+    RtlReleaseSRWLockExclusive( &cpuset_lock );
     return TRUE;
 }
 
