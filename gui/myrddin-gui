#!/usr/bin/env python3
"""Myrddin's launcher window: one entry per game this setup works for (gui/games.ini).

    the icon        a click launches the game, with the multiplier shown below it
    -  4x  +        the frame-generation multiplier: shown frames per frame of the game's (1x: none
                    generated). Changed while the game runs, it is applied at once; the line below
                    says what the layer is doing now (its multiplier, shown and base frame rate).

    gui/myrddin-gui [--games FILE] [--dry-run] [--self-test]

    --games FILE    another list of games than gui/games.ini
    --dry-run       commands are printed, not run (tests: nothing is ever launched)
    --self-test     no window: the list, the icons found, what runs, the commands a click would run

The multiplier chosen per game is kept in ~/.config/myrddin/launcher.ini. Needs GTK 4, libadwaita
and PyGObject.
"""
import argparse
import configparser
import os
import re
import shlex
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
SETTINGS = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "myrddin", "launcher.ini")
STAT = re.compile(r"STAT x(\d+) real=([\d.]+)/s generated=([\d.]+)/s shown=([\d.]+)/s")
ICON = 176  # the icon's edge on screen

CSS = """
window.myrddin, window.myrddin.csd { border-radius: 22px; }
.game-card { padding: 20px 20px 14px 20px; border-radius: 30px; background: alpha(currentColor, 0.05); }
button.game-icon { padding: 0; border-radius: 28px; background: none; box-shadow: none; outline-offset: 3px;
    transition: transform 140ms ease, filter 140ms ease; }
button.game-icon:hover { filter: brightness(1.08); transform: scale(1.02); }
button.game-icon:active { transform: scale(0.97); }
.icon-clip { border-radius: 28px; }
.icon-fallback { background: linear-gradient(135deg, #5b6cff, #b05cf0); color: white; font-size: 60px; font-weight: 800; }
.game-name { font-size: 17px; font-weight: 700; margin-top: 4px; }
.stepper { border-radius: 999px; background: alpha(currentColor, 0.07); padding: 4px; }
.stepper button { border-radius: 999px; min-width: 38px; min-height: 38px; padding: 0; }
.mult { font-size: 21px; font-weight: 800; font-feature-settings: "tnum"; min-width: 68px; }
.state { font-size: 12.5px; opacity: 0.62; min-height: 34px; }
.running-dot { min-width: 14px; min-height: 14px; border-radius: 999px; background: #33d17a;
    border: 3px solid @window_bg_color; margin: 9px; }
"""


def pids_of(name):
    """The processes with this name (as the kernel keeps it: its first 15 characters)."""
    found = []
    for entry in os.listdir("/proc"):
        if entry.isdigit():
            try:
                with open("/proc/%s/comm" % entry) as file:
                    if file.read().strip() == name[:15]:
                        found.append(int(entry))
            except OSError:
                pass
    return found


def last_stat(path):
    """The layer's newest figures: (multiplier, shown, base), or None when they are old or not there."""
    try:
        if time.time() - os.path.getmtime(path) > 30.0:
            return None
        with open(path, "rb") as file:
            file.seek(0, os.SEEK_END)
            file.seek(max(file.tell() - 8192, 0))
            found = STAT.findall(file.read().decode("ascii", "replace"))
    except OSError:
        return None
    if not found:
        return None
    multiplier, real, _generated, shown = found[-1]
    return int(multiplier), float(shown), float(real)


class Game:
    def __init__(self, name, section, stored):
        self.name = name
        self.icons = [word.strip() for word in section.get("icon", "").split(",") if word.strip()]
        self.process = section.get("process", "")
        self.commands = {key: section.get(key, "") for key in ("launch", "launch_off", "mult", "off", "on")}
        self.log = os.path.join(HERE, section.get("log", "logs/fg"))
        self.low = max(section.getint("min", 1), 1)
        self.high = max(section.getint("max", 4), self.low)
        self.setting = min(max(stored if stored else self.high, self.low), self.high)
        self.starting = 0.0  # until when "starting" is said after a click

    def command(self, key, n=None):
        text = self.commands.get(key, "")
        return [word.replace("{n}", str(n if n is not None else self.setting)) for word in shlex.split(text)]

    def state(self):
        """("closed" | "plain" | "fg", figures): plain: it runs without the layer."""
        pids = pids_of(self.process) if self.process else []
        if not pids:
            return "closed", None
        for pid in pids:
            path = os.path.join(self.log, "fg-%d.log" % pid)
            if os.path.isfile(path):
                return "fg", last_stat(path)
        return "plain", None

    def off(self):
        return os.path.exists(os.path.join(self.log, "OFF"))

    def says(self, state, figures):
        if state == "closed":
            return "starting ..." if time.time() < self.starting else ""
        if state == "plain":
            return "running without frame generation\n(the multiplier applies at the next launch)"
        if self.off():
            return "running, generation off"
        if not figures:
            return "running"
        multiplier, shown, base = figures
        return "%dx now\n%.0f fps shown · %.0f from the game" % (multiplier, shown, base)


def load_games(path):
    parser = configparser.ConfigParser(interpolation=None)
    parser.optionxform = str
    if not parser.read(path):
        sys.exit("no list of games at " + path)
    stored = configparser.ConfigParser(interpolation=None)
    stored.read(SETTINGS)
    return [Game(name, parser[name], stored.getint(name, "multiplier", fallback=0) if stored.has_section(name) else 0)
            for name in parser.sections()]


def save(games):
    stored = configparser.ConfigParser(interpolation=None)
    stored.read(SETTINGS)
    for game in games:
        if not stored.has_section(game.name):
            stored.add_section(game.name)
        stored.set(game.name, "multiplier", str(game.setting))
    try:
        os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
        with open(SETTINGS + ".tmp", "w") as file:
            stored.write(file)
        os.replace(SETTINGS + ".tmp", SETTINGS)
    except OSError as error:
        print("the multiplier could not be kept: %s" % error, file=sys.stderr)


class Runner:
    """Runs the list's commands in the project's folder; with dry: says them and runs nothing."""

    def __init__(self, dry):
        self.dry = dry

    def now(self, words):
        """A short command (a switch while the game runs): waited for. True: it went well."""
        if not words:
            return True
        if self.dry:
            print("would run: " + shlex.join(words), flush=True)
            return True
        try:
            return subprocess.run(words, cwd=HERE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                  timeout=10).returncode == 0
        except (OSError, subprocess.TimeoutExpired):
            return False

    def launch(self, words):
        """The game: started on its own, its output in logs/gui/launch.log. True: started."""
        if not words:
            return False
        if self.dry:
            print("would launch: " + shlex.join(words), flush=True)
            return True
        try:
            os.makedirs(os.path.join(HERE, "logs", "gui"), exist_ok=True)
            with open(os.path.join(HERE, "logs", "gui", "launch.log"), "w") as log:
                log.write("%s  %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), shlex.join(words)))
                log.flush()
                subprocess.Popen(words, cwd=HERE, stdin=subprocess.DEVNULL, stdout=log, stderr=subprocess.STDOUT,
                                 start_new_session=True)
            return True
        except OSError as error:
            print("not launched: %s" % error, file=sys.stderr)
            return False


def step(game, runner, by):
    """The multiplier one up or down; applied at once where the game runs with the layer.
    Returns what to tell the user, or None."""
    before = game.setting
    game.setting = min(max(before + by, game.low), game.high)
    if game.setting == before:
        return None
    state, _ = game.state()
    if state != "fg":
        return None
    if game.setting == 1:
        ok = runner.now(game.command("off"))
    else:
        ok = True
        if before == 1 or game.off():  # generation was off: on again first
            ok = runner.now(game.command("on"))
        ok = ok and runner.now(game.command("mult"))
    return None if ok else "The running game did not take the change"


def launch(game, runner):
    """A click on the icon. Returns what to tell the user, or None."""
    state, _ = game.state()
    if state != "closed":
        return "%s is already running" % game.name
    if time.time() < game.starting:
        return "%s is starting" % game.name
    words = game.command("launch_off") if game.setting == 1 else game.command("launch")
    if not runner.launch(words):
        return "%s could not be launched (see logs/gui/launch.log)" % game.name
    game.starting = time.time() + 90.0
    return None


def self_test(games, runner):
    for game in games:
        state, figures = game.state()
        print("%s: %s, multiplier %dx (%d-%d)" % (game.name, state, game.setting, game.low, game.high))
        print("  says: %r" % game.says(state, figures))
        for n in range(game.low, game.high + 1):
            print("  %dx: launch %s" % (n, shlex.join(game.command("launch_off") if n == 1 else game.command("launch", n))))
        game.setting = game.low
        for by in (1, 1, -1, -1, -1):
            told = step(game, runner, by)
            print("  step %+d -> %dx%s" % (by, game.setting, " (%s)" % told if told else ""))
        print("  click: %s" % (launch(game, runner) or "launched"))
    return 0


def window(games, runner, list_path):
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    def icon_file(game, display):
        theme = Gtk.IconTheme.get_for_display(display)
        for name in game.icons:
            path = os.path.expanduser(name)
            if os.path.isfile(path):
                return path
            if theme.has_icon(name):
                found = theme.lookup_icon(name, None, 256, 1, Gtk.TextDirection.NONE, 0).get_file()
                if found and found.get_path():
                    return found.get_path()
        return None

    class Card:
        def __init__(self, game, toast, display):
            self.game = game
            self.toast = toast
            self.box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, halign=Gtk.Align.CENTER,
                               valign=Gtk.Align.CENTER)
            self.box.add_css_class("game-card")

            clip = Gtk.Box(halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
            clip.set_overflow(Gtk.Overflow.HIDDEN)
            clip.add_css_class("icon-clip")
            clip.set_size_request(ICON, ICON)
            path = icon_file(game, display)
            texture = None
            if path:
                try:
                    texture = Gdk.Texture.new_from_filename(path)
                except GLib.Error:
                    texture = None
            if texture:
                image = Gtk.Image.new_from_paintable(texture)
                image.set_pixel_size(ICON)
                clip.append(image)
            else:  # no icon on this machine: the name's initials
                initials = Gtk.Label(label="".join(word[0] for word in game.name.split()[:2]).upper(), hexpand=True,
                                     vexpand=True)
                clip.add_css_class("icon-fallback")
                clip.append(initials)
            self.dot = Gtk.Box(halign=Gtk.Align.END, valign=Gtk.Align.START, visible=False)
            self.dot.add_css_class("running-dot")
            over = Gtk.Overlay(child=clip)
            over.add_overlay(self.dot)
            self.icon = Gtk.Button(child=over, halign=Gtk.Align.CENTER)
            self.icon.add_css_class("game-icon")
            self.icon.add_css_class("flat")
            self.icon.connect("clicked", self.on_launch)
            self.box.append(self.icon)

            name = Gtk.Label(label=game.name)
            name.add_css_class("game-name")
            self.box.append(name)

            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=2, halign=Gtk.Align.CENTER)
            row.add_css_class("stepper")
            self.less = Gtk.Button(icon_name="list-remove-symbolic", tooltip_text="Fewer generated frames")
            self.more = Gtk.Button(icon_name="list-add-symbolic", tooltip_text="More generated frames")
            for button in (self.less, self.more):
                button.add_css_class("flat")
            self.less.connect("clicked", self.on_step, -1)
            self.more.connect("clicked", self.on_step, +1)
            self.mult = Gtk.Label()
            self.mult.add_css_class("mult")
            row.append(self.less)
            row.append(self.mult)
            row.append(self.more)
            self.box.append(row)

            self.state = Gtk.Label(justify=Gtk.Justification.CENTER, wrap=True, max_width_chars=28, yalign=0.0)
            self.state.add_css_class("state")
            self.box.append(self.state)
            self.refresh()

        def tell(self, text):
            if text:
                self.toast.add_toast(Adw.Toast(title=text, timeout=4))

        def on_launch(self, _button):
            self.tell(launch(self.game, runner))
            self.refresh()

        def on_step(self, _button, by):
            self.tell(step(self.game, runner, by))
            save(games)
            self.refresh()

        def refresh(self):
            game = self.game
            state, figures = game.state()
            if state != "closed":
                game.starting = 0.0
            self.mult.set_label("%dx" % game.setting)
            self.less.set_sensitive(game.setting > game.low)
            self.more.set_sensitive(game.setting < game.high)
            self.dot.set_visible(state != "closed")
            self.state.set_label(game.says(state, figures))
            if state == "closed":
                what = "without frame generation" if game.setting == 1 else "with frame generation, %dx" % game.setting
                self.icon.set_tooltip_text("Launch %s %s" % (game.name, what))
            else:
                self.icon.set_tooltip_text("%s is running" % game.name)

    def activate(app):
        if app.get_windows():
            app.get_windows()[0].present()
            return
        display = Gdk.Display.get_default()
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(display, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        toast = Adw.ToastOverlay()
        # (it fills the window's width, so that the entries stand side by side as far as they fit)
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, homogeneous=True, valign=Gtk.Align.CENTER,
                           column_spacing=18, row_spacing=18, margin_top=6, margin_bottom=24, margin_start=24,
                           margin_end=24, max_children_per_line=min(max(len(games), 1), 6), min_children_per_line=1)
        cards = [Card(game, toast, display) for game in games]
        for card in cards:
            flow.append(card.box)
        for child in list(flow):  # (the entries are not to be picked or focused, what is in them is)
            child.set_focusable(False)
        if not cards:
            flow.append(Gtk.Label(label="No games in " + list_path))
        scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                    propagate_natural_width=True, child=flow)
        toast.set_child(scroll)
        view = Adw.ToolbarView(content=toast)
        bar = Adw.HeaderBar(title_widget=Adw.WindowTitle(title="Myrddin", subtitle=""))
        bar.add_css_class("flat")
        view.add_top_bar(bar)
        win = Adw.ApplicationWindow(application=app, title="Myrddin", content=view)
        win.add_css_class("myrddin")
        columns = min(max(len(games), 1), 4)
        win.set_default_size(96 + columns * 252, 470)

        def tick():
            for card in cards:
                card.refresh()
            return True

        GLib.timeout_add_seconds(2, tick)
        win.present()

    # (a dry run is a test: it must not end up as a call to the user's own window)
    flags = Gio.ApplicationFlags.NON_UNIQUE if runner.dry else Gio.ApplicationFlags.DEFAULT_FLAGS
    app = Adw.Application(application_id="net.local.myrddin", flags=flags)
    app.connect("activate", activate)
    return app.run([])


def main():
    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("--games", default=os.path.join(HERE, "gui", "games.ini"))
    parser.add_argument("--dry-run", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    args = parser.parse_args()
    if args.help:
        print(__doc__.strip())
        return 0
    games = load_games(args.games)
    if args.self_test:
        return self_test(games, Runner(True))
    return window(games, Runner(args.dry_run), args.games)


if __name__ == "__main__":
    sys.exit(main())
