# generated or bulky: rebuilt from source, or session data
/build/
/logs/
*.bak*
*.a
__pycache__/
*.pyc
# the AppImage's build folders (the image itself is a release file)
/appimage/out/
/appimage/work/
# this machine's settings and backups of desktop files
/sc-turbo.conf
/backups/
# the Wine runner work: not part of this repository (it gets one of its own)
/wine/
*.exe
# never part of the repository: assistant session data and chat records of any kind
/.claude/
*.jsonl
# working notes of the AppImage builds
/appimage/NOTES-*.md
