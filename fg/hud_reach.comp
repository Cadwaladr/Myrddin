#version 450
// HUD content that moves over the screen, after the field is known ("reach" in
// proto/hud-motion/hudmotion.py): per tile (64x64 pixels) the rough motions, two at most and
// further than SAME apart, of the tiles whose content passes through it on its way from where it
// was (x + motion) to where it is; its own first. One invocation works on one tile.
layout(local_size_x = 8, local_size_y = 8) in;
struct Tile {
    ivec4 own;     // its own search's answer: xy; z: 1 when it has one
    ivec4 around;  // the best of the answers around it, on its own cells: xy; z: state; w: what it leaves unexplained
    ivec4 sums;    // x: arrived content in its changed cells; y: what "not moved" leaves; z: its piece (-1: none)
    vec4 piece;    // (of a piece's first tile) x: content that fits, y: all of it, z: 1 when the piece counts
    vec4 first;    // the field, first round: xy; z: 1 when there is one
    ivec4 refined; // as around, against the field
    vec4 motion;   // the field: xy; z: 1 when there is one; w: how many motions reach the tile
    vec4 reach;    // those motions: xy, zw
};
layout(std430, binding = 6) buffer Markers {
    uint seen, found, pieces, unused;
    Tile tiles[];
} markers;
layout(push_constant) uniform Constants {
    float tiles_w, tiles_h;
    float cap, mode;
} pc;

const float SAME = 6.0;

void main() {
    const ivec2 tile = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 tiles = ivec2(pc.tiles_w, pc.tiles_h);
    if (any(greaterThanEqual(tile, tiles))) {
        return;
    }
    const vec2 low = vec2(tile * 64), high = low + 64.0;
    vec4 reach = vec4(0.0);
    int found = 0;
    // (a motion is at most 207 pixels across and 143 down: four tiles, three tiles; n -1: its own)
    for (int n = -1; n < 63 && found < 2; ++n) {
        const ivec2 other = n < 0 ? tile : tile + ivec2(n % 9 - 4, n / 9 - 3);
        if ((n >= 0 && other == tile) || any(lessThan(other, ivec2(0))) || any(greaterThanEqual(other, tiles))) {
            continue;
        }
        const vec4 motion = markers.tiles[other.y * tiles.x + other.x].motion;
        if (motion.z <= 0.0) {
            continue;
        }
        const vec2 from = vec2(other) * 64.0 + min(motion.xy, vec2(0.0));
        const vec2 to = vec2(other) * 64.0 + 64.0 + max(motion.xy, vec2(0.0));
        if (any(lessThanEqual(to, low)) || any(greaterThanEqual(from, high))) {
            continue;
        }
        if (found == 0) {
            reach.xy = motion.xy;
            found = 1;
        } else if (any(greaterThan(abs(motion.xy - reach.xy), vec2(SAME)))) {
            reach.zw = motion.xy;
            found = 2;
        }
    }
    const int record = tile.y * tiles.x + tile.x;
    markers.tiles[record].reach = reach;
    markers.tiles[record].motion.w = float(found);
}
