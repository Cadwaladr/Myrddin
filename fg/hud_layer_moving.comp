#version 450
// hud_layer.comp for a frame whose HUD has content that moves over the screen (world markers, a
// ship's flight display): the real frame's HUD contribution over the generated frame, and what
// moved since the capture before put where it is on its way at the generated frame's time,
// instead of where it will be ("layer_at" in proto/hud-motion/hudmotion.py). Inputs as in
// hud_layer.comp, the same three of the frame before, per tile of 64x64 pixels the motion field
// and the motions that reach the tile (hud_field.comp, hud_reach.comp), and per pixel whether its
// content moves (hud_which.comp).
//   in place   a pixel's HUD is this frame's, unless that is moving content; then the frame
//              before's, unless that is moving content too; then nothing.
//   moved      for each rough motion that reaches the pixel's tile: the place in this frame that
//              the field brings here by now. What is moving content there goes over what is in
//              place.
//   fill       a pixel whose own content moves, in either capture, also takes what the field
//              brings there when that is not seen to move but was, in the capture before, where
//              the field says (as much, at that place or right next to it): the inside of a
//              filled shape is the same in both captures, and its rear and the pixels beside a
//              moved edge are filled from it. A pixel that did not change never takes this.
//   alike      moved content does not go over what is in place when that is this capture's, did
//              not change, is the same along the motion (in the capture before where it would
//              have come from, in this one where it would have gone) and is like the moved
//              content: it is the inside of the shape that moves, not something under it.
// The layer's alpha is all that tells what changed: something opaque that moves over something
// opaque is not seen to move there.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D current_frame;
layout(binding = 1) uniform sampler2D scene;
layout(binding = 2) uniform sampler2D layer;
layout(binding = 3, rgba8) uniform image2D generated;
layout(binding = 4, r8ui) uniform readonly uimage2D which; // bit 0: this capture's content here moves; bit 1: the one before's did
layout(binding = 5) uniform sampler2D curve; // see hud_layer.comp
struct Tile {
    ivec4 own;     // its own search's answer: xy; z: 1 when it has one
    ivec4 around;  // the best of the answers around it, on its own cells: xy; z: state; w: what it leaves unexplained
    ivec4 sums;    // x: arrived content in its changed cells; y: what "not moved" leaves; z: its piece (-1: none)
    vec4 piece;    // (of a piece's first tile) x: content that fits, y: all of it, z: 1 when the piece counts
    vec4 first;    // the field, first round: xy; z: 1 when there is one
    ivec4 refined; // as around, against the field
    vec4 motion;   // the field: its content was at x + xy in the capture before; z: 1 when there is one; w: how many motions reach the tile
    vec4 reach;    // those motions: xy, zw
};
layout(std430, binding = 6) readonly buffer Markers {
    uint seen, found, pieces, unused;
    Tile tiles[];
} markers;
layout(binding = 7) uniform sampler2D layer_before;
layout(binding = 8) uniform sampler2D frame_before;
layout(binding = 9) uniform sampler2D scene_before;
layout(push_constant) uniform Constants {
    float back;    // how far before this frame the generated one is: 1 - its time between the two
    float gain;    // multiplies the layer's alpha
    float floor_;  // differences below this count as none
    float tiles_w; // tiles in a row
} pc;

const float SAME = 6.0;  // motions closer than this are one piece's
const float EPS = 0.04;  // alphas closer than this did not change
const float ALIKE = 0.1; // alphas closer than this are the same thing's

/// A capture's alpha at a pixel; nothing outside the picture.
float Alpha(sampler2D of, ivec2 at, ivec2 size) {
    return all(greaterThanEqual(at, ivec2(0))) && all(lessThan(at, size)) ? clamp(texelFetch(of, at, 0).a, 0.0, 1.0) : 0.0;
}

/// The field at a place: between the centres of the four tiles around, those with a motion within
/// SAME of the rough one. False: none of them has one.
bool LookUp(vec2 place, vec2 rough, ivec2 size, out vec2 motion) {
    const ivec2 tiles = ivec2(int(pc.tiles_w), (size.y + 63) >> 6);
    const vec2 at = (place - 32.0) / 64.0;
    const ivec2 base = ivec2(floor(at));
    const vec2 part = at - vec2(base);
    float weights = 0.0;
    vec2 sum = vec2(0.0);
    for (int j = 0; j < 2; ++j) {
        for (int i = 0; i < 2; ++i) {
            const ivec2 tile = base + ivec2(i, j);
            if (any(lessThan(tile, ivec2(0))) || any(greaterThanEqual(tile, tiles))) {
                continue;
            }
            const vec4 field = markers.tiles[tile.y * tiles.x + tile.x].motion;
            if (field.z <= 0.0 || any(greaterThan(abs(field.xy - rough), vec2(SAME)))) {
                continue;
            }
            const float weight = (i != 0 ? part.x : 1.0 - part.x) * (j != 0 ? part.y : 1.0 - part.y) + 1e-4;
            weights += weight;
            sum += weight * field.xy;
        }
    }
    motion = weights > 0.0 ? sum / weights : rough;
    return weights > 0.0;
}

vec3 Tone(vec3 colour) {
    const vec3 at = (colour * 255.0 + 0.5) / 256.0;
    return vec3(textureLod(curve, vec2(at.r, 0.5), 0.0).r, textureLod(curve, vec2(at.g, 0.5), 0.0).g,
                textureLod(curve, vec2(at.b, 0.5), 0.0).b);
}

/// The HUD of a frame at a place, as hud_layer.comp works it out: what it added (rgb) on top of
/// the (1 - a) share of the scene.
vec4 Hud(vec3 real, vec3 without, float layer_alpha) {
    const vec3 hudless = Tone(without);
    float alpha = clamp(layer_alpha * pc.gain, 0.0, 1.0);
    const vec3 share = hudless * (1.0 - alpha);
    const vec3 fits = min(vec3(1.0), (real + pc.floor_) / max(share, vec3(1e-4)));
    alpha = 1.0 - (1.0 - alpha) * min(fits.r, min(fits.g, fits.b));
    const vec3 difference = abs(real - hudless);
    if (alpha <= 0.0 && max(difference.r, max(difference.g, difference.b)) <= pc.floor_) {
        return vec4(0.0);
    }
    return vec4(real - hudless * (1.0 - alpha), alpha);
}

vec4 HudNow(ivec2 at) {
    return Hud(texelFetch(current_frame, at, 0).rgb, texelFetch(scene, at, 0).rgb, texelFetch(layer, at, 0).a);
}

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(generated);
    if (any(greaterThanEqual(pixel, size))) {
        return;
    }
    const int tiles_w = int(pc.tiles_w);
    const Tile tile = markers.tiles[(pixel.y >> 6) * tiles_w + (pixel.x >> 6)];
    const vec3 interpolated = Tone(imageLoad(generated, pixel).rgb);
    const int reaching = int(tile.motion.w);
    vec4 hud;
    if (tile.motion.z <= 0.0 && reaching == 0) {
        hud = HudNow(pixel);
    } else {
        const uint here = imageLoad(which, pixel).r;
        if ((here & 1u) == 0u) {
            hud = HudNow(pixel);
        } else if ((here & 2u) == 0u) {
            hud = Hud(texelFetch(frame_before, pixel, 0).rgb, texelFetch(scene_before, pixel, 0).rgb,
                      texelFetch(layer_before, pixel, 0).a);
        } else {
            hud = vec4(0.0);
        }
        for (int k = 0; k < reaching; ++k) {
            const vec2 rough = k == 0 ? tile.reach.xy : tile.reach.zw;
            vec2 motion;
            if (!LookUp(vec2(pixel) - pc.back * rough, rough, size, motion)) {
                continue;
            }
            const ivec2 from = ivec2(floor(vec2(pixel) - pc.back * motion + 0.5));
            if (any(lessThan(from, ivec2(0))) || any(greaterThanEqual(from, size))) {
                continue;
            }
            const ivec2 whole = ivec2(floor(motion + 0.5));
            const float brought = Alpha(layer, from, size);
            if ((imageLoad(which, from).r & 1u) != 0u) {
                if ((here & 1u) == 0u) { // alike: the inside of the shape that moves stays as it is
                    const float mine = Alpha(layer, pixel, size);
                    if (mine > EPS && abs(mine - Alpha(layer_before, pixel, size)) <= EPS &&
                        abs(Alpha(layer_before, pixel + whole, size) - mine) <= ALIKE &&
                        abs(Alpha(layer, pixel - whole, size) - mine) <= ALIKE && abs(brought - mine) <= ALIKE) {
                        continue;
                    }
                }
            } else { // fill: a pixel whose content moves takes what was, before, where the field says
                if ((here & 3u) == 0u || brought <= EPS) {
                    continue;
                }
                float nearest = 9.0;
                for (int j = -1; j <= 1; ++j) {
                    for (int i = -1; i <= 1; ++i) {
                        nearest = min(nearest, abs(Alpha(layer_before, from + whole + ivec2(i, j), size) - brought));
                    }
                }
                if (nearest > ALIKE) {
                    continue;
                }
            }
            const vec4 moved = HudNow(from);
            hud = vec4(moved.rgb + (1.0 - moved.a) * hud.rgb, moved.a + (1.0 - moved.a) * hud.a);
        }
    }
    imageStore(generated, pixel, vec4(clamp(interpolated * (1.0 - hud.a) + hud.rgb, 0.0, 1.0), 1.0));
}
