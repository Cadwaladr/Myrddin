#version 450
// HUD content that moves over the screen (world markers, a ship's flight display): where was the
// content of a tile (64x64 pixels) of this capture of the HUD layer in the capture before? One
// work group, 64 invocations, works on one tile; the shifts to try are shared out among them. On
// the layer's alpha alone (proto/hud-motion/hudmotion.py is the reference: "own"):
//   active   a tile whose arrived content (hud_moved.comp) is at least ACTIVE pixels' worth.
//   level A  cells of 16, arrived content against left content: every shift up to +-192 x +-128
//            pixels; the sum over the tile's cells and one around of |this(x) - before(x + d)|.
//            The smallest shift among those within 5 % of the best.
//   level B  cells of 4, two answers. Far: arrived against left, around A's answer (+-3 cells).
//            Near: all of this capture against all of the one before, weighted with how much
//            changed in the cell, around "not moved" (+-4 cells): what moved by less than its own
//            size lies over where it was, and only its edges changed.
//   level C  pixels, around both of B's answers (+-3 each) and "not moved": the tile's cells of 4
//            with changed pixels, the sum of each against the sum of the 4x4 block of the capture
//            before at the cell's place plus the shift (hud_blocks.comp). In whole numbers. The
//            best; but a much smaller shift that also fits is taken instead (what repeats matches
//            a period further on, one of several markers that look the same matches the next).
// The answer: own.xy, the content was at x + own.xy before; own.z is 1 when there is one. Whether
// it fits is hud_around.comp's to say.
layout(local_size_x = 64) in;
layout(binding = 0) uniform usampler2D blocks;   // hud_blocks.comp
layout(binding = 1) uniform usampler2D cells;
layout(binding = 2) uniform sampler2D quarter;   // hud_moved.comp
layout(binding = 5) uniform sampler2D sixteenth;
struct Tile {
    ivec4 own;     // its own search's answer: xy; z: 1 when it has one
    ivec4 around;  // the best of the answers around it, on its own cells: xy; z: state; w: what it leaves unexplained
    ivec4 sums;    // x: arrived content in its changed cells; y: what "not moved" leaves; z: its piece (-1: none)
    vec4 piece;    // (of a piece's first tile) x: content that fits, y: all of it, z: 1 when the piece counts
    vec4 first;    // the field, first round: xy; z: 1 when there is one
    ivec4 refined; // as around, against the field
    vec4 motion;   // the field: xy; z: 1 when there is one; w: how many motions reach the tile
    vec4 reach;    // those motions: xy, zw
};
layout(std430, binding = 6) buffer Markers {
    uint seen;   // tiles that searched
    uint found;  // tiles with a motion in the end
    uint pieces; // pieces that count
    uint unused;
    Tile tiles[];
} markers;
layout(push_constant) uniform Constants {
    float tiles_w, tiles_h;
    float cap; // more tiles than this search: the HUD as a whole is changing, nothing is said to move
    float mode;
} pc;

const float EPS = 0.04;
const float ACTIVE = 8.0;
const int BORDER = 16;       // of the maps, in cells of 16
const int RXA = 12, RYA = 8; // level A: the range in cells of 16
const int SHIFTS_A = (2 * RXA + 1) * (2 * RYA + 1);
const uint LEAST = 2u;       // changed cells a tile must have
const int ALIAS_FAR = 8, ALIAS_BAND = 4;
const float NONE = 1e30;

shared bool s_over;
shared float s_cost[64], s_cost_near[64];
shared uint s_d2[64], s_pick[64], s_d2_near[64], s_pick_near[64];
// level B: this capture's side, the tile's cells of 4 and two around (20 x 20)
shared float s_arrived[400], s_all[400], s_weight[400];
// level C: the tile's cells of 4 (sum | changed << 16), what the candidates leave unexplained
shared uint s_cell[256];
shared uint s_changed[64], s_content[64];
shared uint s_costs[99];

bool Fits(uint cost, uint content, uint zero) {
    return 10u * cost <= 3u * content && 2u * cost <= zero;
}

/// Level C's candidates: 49 around the far answer, 49 around the near one, "not moved".
ivec2 Candidate(int k, ivec2 far, ivec2 near) {
    const int in_set = k % 49;
    return k == 98 ? ivec2(0) : (k < 49 ? far : near) * 4 + ivec2(in_set % 7 - 3, in_set / 7 - 3);
}

int Size(ivec2 d) {
    return abs(d.x) + abs(d.y);
}

void main() {
    const ivec2 tile = ivec2(gl_WorkGroupID.xy);
    const uint me = gl_LocalInvocationIndex;
    const uint record = uint(tile.y * int(pc.tiles_w) + tile.x);
    const vec2 size16 = vec2(textureSize(sixteenth, 0));
    const ivec2 cell16 = tile * 4 + BORDER;
    float own = 0.0;
    for (int q = 0; q < 4; ++q) {
        const vec4 arrived = textureGather(sixteenth, (vec2(cell16 + 2 * ivec2(q & 1, q >> 1)) + 1.0) / size16, 0);
        own += arrived.x + arrived.y + arrived.z + arrived.w;
    }
    if (own * 256.0 < ACTIVE) {
        if (me == 0u) {
            markers.tiles[record].own = ivec4(0);
        }
        return;
    }
    if (me == 0u) {
        s_over = atomicAdd(markers.seen, 1u) >= uint(pc.cap);
    }
    barrier();
    if (s_over) {
        if (me == 0u) {
            markers.tiles[record].own = ivec4(0);
        }
        return;
    }

    // ---- level A
    float window[36]; // (as textureGather hands them out: four cells to a corner)
    const ivec2 corner16 = cell16 - 1;
    for (int q = 0; q < 9; ++q) {
        const vec4 four = textureGather(sixteenth, (vec2(corner16 + 2 * ivec2(q % 3, q / 3)) + 1.0) / size16, 0);
        window[q * 4] = four.x;
        window[q * 4 + 1] = four.y;
        window[q * 4 + 2] = four.z;
        window[q * 4 + 3] = four.w;
    }
    float costs[7];
    float least = NONE;
    for (int j = 0; j < 7; ++j) {
        const int shift = int(me) + 64 * j;
        costs[j] = NONE;
        if (shift >= SHIFTS_A) {
            continue;
        }
        const ivec2 d = ivec2(shift % (2 * RXA + 1) - RXA, shift / (2 * RXA + 1) - RYA);
        float cost = 0.0;
        for (int q = 0; q < 9; ++q) {
            const vec4 four = textureGather(sixteenth, (vec2(corner16 + d + 2 * ivec2(q % 3, q / 3)) + 1.0) / size16, 1);
            cost += abs(window[q * 4] - four.x) + abs(window[q * 4 + 1] - four.y) + abs(window[q * 4 + 2] - four.z) +
                    abs(window[q * 4 + 3] - four.w);
        }
        costs[j] = cost;
        least = min(least, cost);
    }
    s_cost[me] = least;
    barrier();
    for (int i = 0; i < 64; ++i) {
        least = min(least, s_cost[i]);
    }
    uint d2 = 0xffffffffu, pick = 0xffffffffu;
    for (int j = 0; j < 7; ++j) {
        const int shift = int(me) + 64 * j;
        if (shift >= SHIFTS_A || costs[j] > least * 1.05 + 1e-4) {
            continue;
        }
        const ivec2 d = ivec2(shift % (2 * RXA + 1) - RXA, shift / (2 * RXA + 1) - RYA);
        if (uint(dot(d, d)) < d2) {
            d2 = uint(dot(d, d));
            pick = uint(shift);
        }
    }
    s_d2[me] = d2;
    s_pick[me] = pick;
    // (level B's windows, while the others are at the same point)
    const vec2 size4 = vec2(textureSize(quarter, 0));
    const ivec2 corner4 = tile * 16 + BORDER * 4 - 2;
    for (uint q = me; q < 100u; q += 64u) {
        const ivec2 at = 2 * ivec2(q % 10u, q / 10u);
        const vec2 corner = (vec2(corner4 + at) + 1.0) / size4;
        const vec4 arrived = textureGather(quarter, corner, 0);
        const vec4 left = textureGather(quarter, corner, 1);
        const vec4 all = textureGather(quarter, corner, 2);
        const uint first = uint(at.y * 20 + at.x); // x: below, y: below right, z: right, w: this one
        s_arrived[first] = arrived.w;
        s_arrived[first + 1u] = arrived.z;
        s_arrived[first + 20u] = arrived.x;
        s_arrived[first + 21u] = arrived.y;
        s_all[first] = all.w;
        s_all[first + 1u] = all.z;
        s_all[first + 20u] = all.x;
        s_all[first + 21u] = all.y;
        s_weight[first] = max(arrived.w, left.w);
        s_weight[first + 1u] = max(arrived.z, left.z);
        s_weight[first + 20u] = max(arrived.x, left.x);
        s_weight[first + 21u] = max(arrived.y, left.y);
    }
    barrier();
    for (int i = 0; i < 64; ++i) {
        if (s_d2[i] < d2 || (s_d2[i] == d2 && s_pick[i] < pick)) {
            d2 = s_d2[i];
            pick = s_pick[i];
        }
    }
    const ivec2 answer_a = ivec2(int(pick) % (2 * RXA + 1) - RXA, int(pick) / (2 * RXA + 1) - RYA);

    // ---- level B: far (one shift of 49 for an invocation), near (81: one or two)
    float far = NONE;
    const ivec2 d_far = answer_a * 4 + ivec2(int(me) % 7 - 3, int(me) / 7 - 3);
    if (me < 49u) {
        far = 0.0;
        for (uint q = 0u; q < 100u; ++q) {
            const ivec2 at = 2 * ivec2(q % 10u, q / 10u);
            const vec4 four = textureGather(quarter, (vec2(corner4 + d_far + at) + 1.0) / size4, 1);
            const uint first = uint(at.y * 20 + at.x);
            far += abs(s_arrived[first] - four.w) + abs(s_arrived[first + 1u] - four.z) +
                   abs(s_arrived[first + 20u] - four.x) + abs(s_arrived[first + 21u] - four.y);
        }
    }
    float near[2];
    float least_near = NONE;
    for (int j = 0; j < 2; ++j) {
        const int shift = int(me) + 64 * j;
        near[j] = NONE;
        if (shift >= 81) {
            continue;
        }
        const ivec2 d = ivec2(shift % 9 - 4, shift / 9 - 4);
        float cost = 0.0;
        for (uint q = 0u; q < 100u; ++q) {
            const ivec2 at = 2 * ivec2(q % 10u, q / 10u);
            const vec4 four = textureGather(quarter, (vec2(corner4 + d + at) + 1.0) / size4, 3);
            const uint first = uint(at.y * 20 + at.x);
            cost += s_weight[first] * abs(s_all[first] - four.w) + s_weight[first + 1u] * abs(s_all[first + 1u] - four.z) +
                    s_weight[first + 20u] * abs(s_all[first + 20u] - four.x) +
                    s_weight[first + 21u] * abs(s_all[first + 21u] - four.y);
        }
        near[j] = cost;
        least_near = min(least_near, cost);
    }
    s_cost[me] = far;
    s_cost_near[me] = least_near;
    barrier();
    least = NONE;
    least_near = NONE;
    for (int i = 0; i < 64; ++i) {
        least = min(least, s_cost[i]);
        least_near = min(least_near, s_cost_near[i]);
    }
    s_d2[me] = far <= least * 1.05 + 1e-4 ? uint(dot(d_far, d_far)) : 0xffffffffu;
    s_pick[me] = me;
    uint d2_near = 0xffffffffu, pick_near = 0xffffffffu;
    for (int j = 0; j < 2; ++j) {
        const int shift = int(me) + 64 * j;
        if (shift >= 81 || near[j] > least_near * 1.05 + 1e-4) {
            continue;
        }
        const ivec2 d = ivec2(shift % 9 - 4, shift / 9 - 4);
        if (uint(dot(d, d)) < d2_near) {
            d2_near = uint(dot(d, d));
            pick_near = uint(shift);
        }
    }
    s_d2_near[me] = d2_near;
    s_pick_near[me] = pick_near;
    // (level C's cells, while the others are at the same point: four of the tile's 256 each)
    const ivec2 origin = tile * 64;
    uint changed = 0u, content = 0u;
    for (uint k = me * 4u; k < me * 4u + 4u; ++k) {
        const uvec4 cell = texelFetch(cells, tile * 16 + ivec2(k & 15u, k >> 4), 0);
        s_cell[k] = cell.r | cell.b << 16;
        changed += cell.b;
        content += cell.b != 0u ? cell.g : 0u;
    }
    s_changed[me] = changed;
    s_content[me] = content;
    barrier();
    d2 = 0xffffffffu;
    pick = 0xffffffffu;
    d2_near = 0xffffffffu;
    pick_near = 0xffffffffu;
    for (int i = 0; i < 64; ++i) {
        if (s_d2[i] < d2 || (s_d2[i] == d2 && s_pick[i] < pick)) {
            d2 = s_d2[i];
            pick = s_pick[i];
        }
        if (s_d2_near[i] < d2_near || (s_d2_near[i] == d2_near && s_pick_near[i] < pick_near)) {
            d2_near = s_d2_near[i];
            pick_near = s_pick_near[i];
        }
    }
    const ivec2 answer_far = answer_a * 4 + ivec2(int(pick) % 7 - 3, int(pick) / 7 - 3);
    const ivec2 answer_near = ivec2(int(pick_near) % 9 - 4, int(pick_near) / 9 - 4);

    // ---- level C: 49 around the far answer, 49 around the near one, "not moved"
    changed = 0u;
    content = 0u;
    for (int i = 0; i < 64; ++i) {
        changed += s_changed[i];
        content += s_content[i];
    }
    if (changed < LEAST) {
        if (me == 0u) {
            markers.tiles[record].own = ivec4(0);
        }
        return;
    }
    const ivec2 blocks_size = textureSize(blocks, 0);
    for (int candidate = int(me); candidate < 99; candidate += 64) {
        const ivec2 d = Candidate(candidate, answer_far, answer_near);
        uint cost = 0u;
        for (uint k = 0u; k < 256u; ++k) {
            const uint cell = s_cell[k];
            if (cell >> 16 == 0u) {
                continue;
            }
            const ivec2 at = origin + 4 * ivec2(k & 15u, k >> 4) + d + 3;
            uint before = 0u;
            if (all(greaterThanEqual(at, ivec2(0))) && all(lessThan(at, blocks_size))) {
                before = texelFetch(blocks, at, 0).r;
            }
            cost += uint(abs(int(cell & 0xffffu) - int(before)));
        }
        s_costs[candidate] = cost;
    }
    barrier();
    if (me != 0u) {
        return;
    }
    const uint zero = s_costs[98];
    int best = 0, smallest = 1 << 30;
    for (int k = 0; k < 99; ++k) {
        if (s_costs[k] < s_costs[best]) {
            best = k;
        }
        const ivec2 d = Candidate(k, answer_far, answer_near);
        if (d != ivec2(0) && Fits(s_costs[k], content, zero)) {
            smallest = min(smallest, Size(d));
        }
    }
    if (smallest < 1 << 30 && Size(Candidate(best, answer_far, answer_near)) - smallest > ALIAS_FAR) {
        best = -1;
        for (int k = 0; k < 99; ++k) {
            const ivec2 d = Candidate(k, answer_far, answer_near);
            if (d != ivec2(0) && Fits(s_costs[k], content, zero) && Size(d) <= smallest + ALIAS_BAND &&
                (best < 0 || s_costs[k] < s_costs[best])) {
                best = k;
            }
        }
    }
    markers.tiles[record].own = ivec4(Candidate(best, answer_far, answer_near), 1, 0);
}
